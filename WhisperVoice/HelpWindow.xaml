<Window x:Class="WhisperVoice.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка - Горячие клавиши" Height="260" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Background="#F9F9F9" Closing="Window_Closing">
    <StackPanel Margin="20">
        <TextBlock Text="Горячие клавиши:" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,50,0">
                <TextBlock Text="F7" FontSize="14" FontWeight="Bold" Foreground="#005A9E" Margin="0,0,0,10"/>
                <TextBlock Text="Ctrl + F7" FontSize="14" FontWeight="Bold" Foreground="#005A9E" Margin="0,0,0,10"/>
                <TextBlock Text="F8" FontSize="14" FontWeight="Bold" Foreground="#D13438" Margin="0,0,0,10"/>
                <TextBlock Text="F9" FontSize="14" FontWeight="Bold" Foreground="#107C10" Margin="0,0,0,10"/>
                <TextBlock Text="Ctrl + F9" FontSize="14" FontWeight="Bold" Foreground="#881798" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="- Открыть / Скрыть панель" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="- Открыть окно Блокнота" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="- Старт / Стоп записи (RU/UA)" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="- Старт / Стоп записи (EN)" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="- Запись с ПЕРЕВОДОМ в EN" FontSize="14" Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>