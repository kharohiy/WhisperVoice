<Window x:Class="WhisperVoice.MissingModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitleMissingModel}"
        Width="500" Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            Padding="28,22,28,20">
        <StackPanel>

            <!-- Title -->
            <TextBlock Text="{DynamicResource MissingModelTitle}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#FFCC00"
                       Margin="0,0,0,10"/>

            <!-- Body -->
            <TextBlock Text="{DynamicResource MissingModelBody}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <!-- Download hyperlink -->
            <TextBlock Margin="0,0,0,18">
                <Hyperlink NavigateUri="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin?download=true"
                           RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="{DynamicResource MissingModelDownloadBtn}"/>
                </Hyperlink>
            </TextBlock>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource MissingModelSettingsBtn}"
                        MinWidth="150" Padding="10,4"
                        Margin="0,0,10,0"
                        Click="BtnOpenSettings_Click"/>
                <Button Content="✕ Close"
                        MinWidth="80" Padding="10,4"
                        IsCancel="True"
                        Click="BtnClose_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
