<Window x:Class="WhisperVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Height="640" Width="295"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" Background="#F0F0F0">

    <Window.Resources>

        <!-- ═══ VU Meter — horizontal segmented bar ═════════════════════════ -->
        <Style x:Key="VuMeterStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root" Height="{TemplateBinding Height}">
                            <Border Background="#DDDDDD" CornerRadius="3" x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{TemplateBinding Foreground}"/>
                            <!-- 16-segment overlay -->
                            <ItemsControl IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="16" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <Border/><Border/><Border/><Border/>
                                    <Border/><Border/><Border/><Border/>
                                    <Border/><Border/><Border/><Border/>
                                    <Border/><Border/><Border/><Border/>
                                </ItemsControl.Items>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0" BorderThickness="1,0,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ History list item style ══════════════════════════════════ -->
        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding"  Value="6,4"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E8E8E8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F4FD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE8F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <StackPanel Margin="13" VerticalAlignment="Top">

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <Grid Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource MainHeaderText}"
                       FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <!-- Help button intentionally removed (Step 4).
                 First-launch tutorial will be implemented separately. -->
        </Grid>

        <!-- ── Mic status label ────────────────────────────────────────── -->
        <TextBlock x:Name="LblMicName"
                   Text="{DynamicResource LblNoMicSelected}"
                   Foreground="Red" FontSize="14" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"
                   TextWrapping="Wrap" TextAlignment="Center"/>

        <!-- ── Action buttons ─────────────────────────────────────────── -->
        <Button Content="{DynamicResource BtnSelectMicText}"
                Height="32" Margin="0,0,0,8"
                Click="BtnSelectMic_Click"
                HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>

        <Button Content="{DynamicResource BtnSoundText}"
                Height="32" Margin="0,0,0,8"
                Click="BtnSound_Click"
                HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>

        <Button Content="{DynamicResource BtnPromptText}"
                Height="32" Margin="0,0,0,8"
                Click="BtnPrompt_Click"
                HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>

        <Button x:Name="BtnLanguageSettings"
                Content="{DynamicResource BtnLanguageSettingsText}"
                Height="32" Margin="0,0,0,8"
                Click="BtnLanguageSettings_Click"
                HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"
                ToolTip="Настройки языка, модели, VAD и горячих клавиш"/>

        <Button Content="{DynamicResource BtnOpenNotepadText}"
                Height="32" Margin="0,0,0,10"
                Click="BtnOpenNotepad_Click"
                HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>

        <Separator Margin="0,0,0,10" Background="#CCCCCC"/>

        <!-- ── Volume + VU meter ───────────────────────────────────────── -->
        <StackPanel x:Name="VolumePanel" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource LblSignalLevel}"
                       FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
            <ProgressBar x:Name="VuMeter" Style="{StaticResource VuMeterStyle}"
                         Height="16" Minimum="0" Maximum="100" Value="0"
                         Foreground="LimeGreen" Margin="0,0,0,10"/>
            <TextBlock x:Name="LblVolume"
                       Text="{DynamicResource LblMicVolume}"
                       FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
            <Slider x:Name="SldVolume" Minimum="0" Maximum="100"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Height="25" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- ── VAD indicator ─────────────────────────────────────────── -->
        <StackPanel x:Name="VadPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,6"
                    Visibility="Collapsed">
            <Ellipse x:Name="VadDot" Width="11" Height="11"
                     Fill="LimeGreen" Opacity="1"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{DynamicResource VadStatusText}"
                       FontSize="11" Foreground="#555"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Processing panel (status + cancel) ────────────────────── -->
        <StackPanel x:Name="ProcessingPanel" Visibility="Collapsed" Margin="0,0,0,6">
            <TextBlock x:Name="LblStatus" FontSize="11" Foreground="#444"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
            <Button x:Name="BtnCancel"
                    Content="{DynamicResource BtnCancelText}"
                    Height="28"
                    Background="#FFE4E4" Foreground="DarkRed"
                    FontWeight="Bold" FontSize="12"
                    Click="BtnCancel_Click"/>
        </StackPanel>

        <Separator Margin="0,4,0,8" Background="#CCCCCC"/>

        <!-- ── Transcription history ──────────────────────────────────── -->
        <Grid Margin="0,0,0,4">
            <TextBlock Text="{DynamicResource LblHistoryHeader}"
                       FontSize="12" Foreground="#444"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnClearHistory" Content="🗑" Width="24" Height="22"
                    HorizontalAlignment="Right" FontSize="11"
                    ToolTip="{DynamicResource BtnClearHistoryTooltip}"
                    Click="BtnClearHistory_Click"/>
        </Grid>

        <ListBox x:Name="HistoryList" Height="152"
                 ItemContainerStyle="{StaticResource HistoryItemStyle}"
                 SelectionChanged="HistoryList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="White" BorderBrush="#CCC" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding TimeLabel}"
                                   FontSize="9" Foreground="#999"/>
                        <TextBlock Text="{Binding ShortText}"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="#222"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Copy-feedback tooltip-style overlay -->
        <Border x:Name="CopyFeedback" Background="#4CAF50" CornerRadius="4"
                Padding="10,4" HorizontalAlignment="Center" Margin="0,4,0,0"
                Visibility="Collapsed">
            <TextBlock Text="{DynamicResource CopyFeedbackText}"
                       Foreground="White" FontSize="11"/>
        </Border>

    </StackPanel>
</Window>
