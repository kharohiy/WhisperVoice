<Window x:Class="WhisperVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Height="700" Width="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" Background="#F0F0F0">

    <Window.Resources>

        <!-- ═══ VU Meter — horizontal segmented bar ═════════════════════════ -->
        <Style x:Key="VuMeterStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root" Height="{TemplateBinding Height}">
                            <Border Background="#DDDDDD" CornerRadius="3" x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{TemplateBinding Foreground}"/>
                            <!-- 16-segment overlay -->
                            <ItemsControl IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="16" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                </ItemsControl.Items>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0" BorderThickness="1,0,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ History list item style ══════════════════════════════════ -->
        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding"  Value="6,4"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E8E8E8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F4FD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE8F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <StackPanel Margin="13" VerticalAlignment="Top">

        <!-- ── Header: active recording language (Task 2) ────────────── -->
        <Grid Margin="0,0,0,10">
            <TextBlock x:Name="LblCurrentLanguage"
                       FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- ── Mic status label (moved; see VolumePanel for device name) ── -->
        <TextBlock x:Name="LblMicName"
                   Text="{DynamicResource LblNoMicSelected}"
                   Foreground="Red" FontSize="14" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"
                   TextWrapping="Wrap" TextAlignment="Center"/>

        <!-- ── Action buttons ─────────────────────────────────────────── -->
        <Button Content="{DynamicResource BtnSelectMicText}"
                Height="32" Margin="0,0,0,8"
                Click="BtnSelectMic_Click"
                HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>

        <Button Content="{DynamicResource BtnPromptText}"
                Height="32" Margin="0,0,0,8"
                Click="BtnPrompt_Click"
                HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>

        <Button x:Name="BtnLanguageSettings"
                Content="{DynamicResource BtnSettingsText}"
                Height="32" Margin="0,0,0,8"
                Click="BtnLanguageSettings_Click"
                HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"
                ToolTip="{DynamicResource BtnSettingsTooltip}"/>

        <Button Content="{DynamicResource BtnOpenNotepadText}"
                Height="32" Margin="0,0,0,10"
                Click="BtnOpenNotepad_Click"
                HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>

        <Separator Margin="0,0,0,10" Background="#CCCCCC"/>

        <!-- ── Volume + VU meter ───────────────────────────────────────── -->
        <StackPanel x:Name="VolumePanel" Margin="0,0,0,8" Visibility="Collapsed">
            <!-- Task 2c: selected device label sits directly above VU meter -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <TextBlock Text="{DynamicResource LblSelectedDevice}"
                           FontSize="11" Foreground="#777"/>
                <TextBlock x:Name="LblSelectedDeviceName"
                           FontSize="11" FontWeight="SemiBold" Foreground="#1565C0"
                           Margin="4,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource LblSignalLevel}"
                       FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
            <ProgressBar x:Name="VuMeter" Style="{StaticResource VuMeterStyle}"
                         Height="16" Minimum="0" Maximum="100" Value="0"
                         Foreground="LimeGreen" Margin="0,0,0,10"/>
            <TextBlock x:Name="LblVolume"
                       Text="{DynamicResource LblMicVolume}"
                       FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
            <Slider x:Name="SldVolume" Minimum="0" Maximum="100"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Height="25" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- ── VAD indicator ─────────────────────────────────────────── -->
        <StackPanel x:Name="VadPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,6"
                    Visibility="Collapsed">
            <Ellipse x:Name="VadDot" Width="11" Height="11"
                     Fill="LimeGreen" Opacity="1"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{DynamicResource VadStatusText}"
                       FontSize="11" Foreground="#555"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Processing panel (status + cancel) ────────────────────── -->
        <StackPanel x:Name="ProcessingPanel" Visibility="Collapsed" Margin="0,0,0,6">
            <TextBlock x:Name="LblStatus" FontSize="11" Foreground="#444"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
            <Button x:Name="BtnCancel"
                    Content="{DynamicResource BtnCancelText}"
                    Height="28"
                    Background="#FFE4E4" Foreground="DarkRed"
                    FontWeight="Bold" FontSize="12"
                    Click="BtnCancel_Click"/>
        </StackPanel>

        <Separator Margin="0,4,0,8" Background="#CCCCCC"/>

        <!-- ── Transcription history ──────────────────────────────────── -->
        <Grid Margin="0,0,0,4">
            <TextBlock Text="{DynamicResource LblHistoryHeader}"
               FontSize="12" Foreground="#444"
               VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="BtnDiagLog" Content="📋" Width="24" Height="22"
                FontSize="11" Margin="0,0,6,0"
                FontFamily="Segoe UI Emoji"
                ToolTip="Open diagnostic log (whisper_diagnostic.log)"
                Click="BtnDiagLog_Click"/>

                <Button x:Name="BtnExportHistory" Content="💾" Width="24" Height="22"
                FontSize="11" Margin="0,0,6,0"
                FontFamily="Segoe UI Emoji"
                ToolTip="Export history to file"
                Click="BtnExportHistory_Click"/>

                <Button x:Name="BtnClearHistory" Content="🗑" Width="24" Height="22"
                FontSize="11"
                FontFamily="Segoe UI Emoji"
                ToolTip="{DynamicResource BtnClearHistoryTooltip}"
                Click="BtnClearHistory_Click"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="HistoryList" Height="200"
                 ItemContainerStyle="{StaticResource HistoryItemStyle}"
                 SelectionChanged="HistoryList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="White" BorderBrush="#CCC" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding TimeLabel}"
                                       FontSize="9" Foreground="#999"/>
                            <TextBlock Text="{Binding ShortText}"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="#222"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#3D7EAA" CornerRadius="3"
                                Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Badge}"
                                       FontSize="9" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Copy-feedback tooltip-style overlay -->
        <Border x:Name="CopyFeedback" Background="#4CAF50" CornerRadius="4"
                Padding="10,4" HorizontalAlignment="Center" Margin="0,4,0,0"
                Visibility="Collapsed">
            <TextBlock Text="{DynamicResource CopyFeedbackText}"
                       Foreground="White" FontSize="11"/>
        </Border>

    </StackPanel>
</Window>
