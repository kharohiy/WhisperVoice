<Window x:Class="WhisperVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Height="450" Width="660"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" Background="#F0F0F0">

    <Window.Resources>
        <!-- ═══ VU Meter — horizontal segmented bar ═════════════════════════ -->
        <Style x:Key="VuMeterStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root" Height="{TemplateBinding Height}">
                            <Border Background="#DDDDDD" CornerRadius="3" x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{TemplateBinding Foreground}"/>
                            <!-- 16-segment overlay -->
                            <ItemsControl IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="16" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <Border/><Border/><Border/><Border/>
                                    <Border/><Border/><Border/><Border/>
                                    <Border/><Border/><Border/><Border/>
                                    <Border/><Border/><Border/><Border/>
                                </ItemsControl.Items>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0" BorderThickness="1,0,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ History list item style ══════════════════════════════════ -->
        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding"  Value="6,4"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#E8E8E8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F4FD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE8F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Row 0 (Span 2): Global Status Strip ────────────── -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Border HorizontalAlignment="Left" Background="#E0E0E0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                <TextBlock x:Name="LblHotkeyMode" FontSize="10" Foreground="#555" FontWeight="SemiBold"/>
            </Border>

            <TextBlock x:Name="LblCurrentLanguage"
                       FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock x:Name="IconPrivacy" Text="ℹ" FontSize="16" Foreground="#1565C0" 
                       HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Help" 
                       ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="10000"/>
        </Grid>

        <!-- ── Column 0 (Left Side): Utility Controls ────────────── -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <Button Content="{DynamicResource BtnSelectMicText}"   Style="{StaticResource BtnDefault}" Margin="0,0,0,6" Click="BtnSelectMic_Click" HorizontalContentAlignment="Left"/>
            <Button Content="{DynamicResource BtnPromptText}"       Style="{StaticResource BtnDefault}" Margin="0,0,0,6" Click="BtnPrompt_Click"    HorizontalContentAlignment="Left"/>
            <Button x:Name="BtnLanguageSettings" Content="{DynamicResource BtnSettingsText}" Style="{StaticResource BtnDefault}" Margin="0,0,0,6" Click="BtnLanguageSettings_Click" HorizontalContentAlignment="Left" ToolTip="{DynamicResource BtnSettingsTooltip}"/>
            <Button Content="{DynamicResource BtnOpenNotepadText}"  Style="{StaticResource BtnDefault}" Margin="0,0,0,10" Click="BtnOpenNotepad_Click" HorizontalContentAlignment="Left"/>

            <Separator Margin="0,0,0,10" Background="#CCCCCC"/>

            <!-- Mic Name Label -->
            <TextBlock x:Name="LblMicName" Text="{DynamicResource LblNoMicSelected}" Foreground="Red" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>

            <!-- Volume + VU meter -->
            <StackPanel x:Name="VolumePanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="{DynamicResource LblSelectedDevice}" FontSize="10" Foreground="#777"/>
                    <TextBlock x:Name="LblSelectedDeviceName" FontSize="10" FontWeight="SemiBold" Foreground="#1565C0" Margin="4,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                
                <TextBlock Text="{DynamicResource LblSignalLevel}" FontSize="11" Foreground="#555" Margin="0,0,0,2"/>
                <ProgressBar x:Name="VuMeter" Style="{StaticResource VuMeterStyle}" Height="12" Minimum="0" Maximum="100" Value="0" Foreground="LimeGreen" Margin="0,0,0,8"/>
                
                <TextBlock x:Name="LblVolume" Text="{DynamicResource LblMicVolume}" FontSize="11" FontWeight="Medium" Margin="0,0,0,2"/>
                <Slider x:Name="SldVolume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Height="22" Margin="0,0,0,8"/>
            </StackPanel>

            <!-- VAD indicator -->
            <StackPanel x:Name="VadPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed">
                <Ellipse x:Name="VadDot" Width="10" Height="10" Fill="LimeGreen" Opacity="1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{DynamicResource VadStatusText}" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Column 1 (Right Side): Hero Button & History ────────────── -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Hero Button -->
                <RowDefinition Height="Auto"/> <!-- Processing Panel -->
                <RowDefinition Height="Auto"/> <!-- History Header -->
                <RowDefinition Height="*"/>    <!-- History List -->
                <RowDefinition Height="Auto"/> <!-- Copy Feedback -->
            </Grid.RowDefinitions>

            <!-- Hero Button -->
            <Button x:Name="BtnActionRecord" Grid.Row="0"
                    Content="{DynamicResource BtnHeroIdle}"
                    Height="80" Margin="0,0,0,10"
                    FontSize="24" FontWeight="Bold" Foreground="White"
                    Background="#1565C0" BorderThickness="0"
                    Cursor="Hand" Click="BtnActionRecord_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Processing Panel (Status + Cancel) -->
            <StackPanel x:Name="ProcessingPanel" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock x:Name="LblStatus" FontSize="12" Foreground="#444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="BtnCancel" Content="{DynamicResource BtnCancelText}" Height="30" Background="#FFEBEE" Foreground="#C62828" FontWeight="Bold" FontSize="12" Padding="12,0" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- History Header & Toolbar -->
            <Grid Grid.Row="2" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource LblHistoryHeader}" FontSize="12" Foreground="#444" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnDiagLog"       Content="📋" Style="{StaticResource BtnIconSm}" Margin="0,0,6,0" FontFamily="Segoe UI Emoji" ToolTip="Open diagnostic log" Click="BtnDiagLog_Click"/>
                    <Button x:Name="BtnExportHistory" Content="💾" Style="{StaticResource BtnIconSm}" Margin="0,0,6,0" FontFamily="Segoe UI Emoji" ToolTip="Export history to file" Click="BtnExportHistory_Click"/>
                    <Button x:Name="BtnClearHistory"  Content="🗑" Style="{StaticResource BtnIconSm}" FontFamily="Segoe UI Emoji" ToolTip="{DynamicResource BtnClearHistoryTooltip}" Click="BtnClearHistory_Click"/>
                </StackPanel>
            </Grid>

            <!-- History List -->
            <ListBox Grid.Row="3" x:Name="HistoryList" ItemContainerStyle="{StaticResource HistoryItemStyle}" SelectionChanged="HistoryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White" BorderBrush="#CCC" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="#999"/>
                                <TextBlock Text="{Binding ShortText}" TextWrapping="Wrap" FontSize="12" Foreground="#222"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#3D7EAA" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Badge}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Copy-feedback -->
            <Border Grid.Row="4" x:Name="CopyFeedback" Background="#4CAF50" CornerRadius="4" Padding="10,4" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource CopyFeedbackText}" Foreground="White" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</Window>
