<Window x:Class="WhisperVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper Control Panel" Height="470" Width="260"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" Background="#F0F0F0">

    <Window.Resources>

        <!--
            VU Meter style. Uses a simple working template:
            - Track: grey rounded background
            - Fill:  a Border whose Width is bound to the ProgressBar's Value
                     via a simple ScaleTransform on a Canvas clip.
            WPF's built-in PART_Track / PART_Indicator names are used so the
            framework wires up the width automatically — no converter needed.
        -->
        <Style x:Key="VuMeterStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root" Height="{TemplateBinding Height}">

                            <!-- Track (background) -->
                            <Border Background="#DDDDDD" CornerRadius="3"
                                    x:Name="PART_Track"/>

                            <!-- Filled indicator — WPF resizes this automatically -->
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3"
                                    Background="{TemplateBinding Foreground}"/>

                            <!-- Segment grid lines drawn on top -->
                            <ItemsControl IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="16" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <!-- 15 separators for 16 segments -->
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                    <Border/>
                                </ItemsControl.Items>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0" BorderThickness="1,0,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <StackPanel Margin="15" VerticalAlignment="Top">

        <Grid Margin="0,0,0,10">
            <TextBlock Text="⚙️ Настройки" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="?" Width="25" Height="25"
                    HorizontalAlignment="Right" Click="BtnHelp_Click"/>
        </Grid>

        <TextBlock x:Name="LblMicName" Text="⚠️ ВЫБЕРИТЕ МИКРОФОН!" Foreground="Red"
                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,0,0,15" TextWrapping="Wrap" TextAlignment="Center"/>

        <Button Content="📋 Выбрать микрофон (Список)" Height="32" Margin="0,0,0,10"
                Click="BtnSelectMic_Click" HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>
        <Button Content="🔊 Звук Windows (Проверка)" Height="32" Margin="0,0,0,10"
                Click="BtnSound_Click" HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>
        <Button Content="🏷️ Редактор словаря (Prompt)" Height="32" Margin="0,0,0,10"
                Click="BtnPrompt_Click" HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>
        <Button Content="📝 Открыть Блокнот (Notepad)" Height="32" Margin="0,0,0,15"
                Click="BtnOpenNotepad_Click" HorizontalContentAlignment="Left"
                Padding="10,0,5,0" FontSize="13"/>

        <Separator Margin="0,5,0,15" Background="#CCCCCC"/>

        <StackPanel x:Name="VolumePanel" Margin="0,0,0,10" Visibility="Collapsed">

            <TextBlock Text="Уровень сигнала:" FontSize="12" Foreground="#555555"
                       Margin="10,0,0,4"/>

            <ProgressBar x:Name="VuMeter"
                         Style="{StaticResource VuMeterStyle}"
                         Height="16"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="LimeGreen"
                         Margin="10,0,10,10"/>

            <TextBlock x:Name="LblVolume" Text="Громкость микрофона:"
                       FontSize="13" FontWeight="Medium" Margin="10,0,0,8"/>
            <Slider x:Name="SldVolume" Minimum="0" Maximum="100"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Height="25" Margin="10,0,10,0"/>

        </StackPanel>

    </StackPanel>
</Window>
