<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══ MainWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="AppTitle">Whisper Control Panel</sys:String>
    <sys:String x:Key="MainHeaderText">⚙️ Configuración</sys:String>
    <sys:String x:Key="LblNoMicSelected">⚠️ ¡SELECCIONE UN MICRÓFONO!</sys:String>
    <sys:String x:Key="LblRecording">🔴 GRABANDO...</sys:String>
    <sys:String x:Key="LblProcessing">🧠 PROCESANDO...&#x0a;(Por favor espere)</sys:String>
    <sys:String x:Key="BtnSelectMicText">📋 Seleccionar micrófono (Lista)</sys:String>
    <sys:String x:Key="BtnPromptText">🏷️ Editor de diccionario (Prompt)</sys:String>
    <sys:String x:Key="BtnSettingsText">⚙️ Configuración</sys:String>
    <sys:String x:Key="BtnSettingsTooltip">Configuración de idioma, modelo, VAD y atajos</sys:String>
    <sys:String x:Key="BtnOpenNotepadText">📝 Abrir bloc de notas</sys:String>
    <sys:String x:Key="LblSignalLevel">Nivel de señal:</sys:String>
    <sys:String x:Key="LblMicVolume">Volumen del micrófono:</sys:String>
    <sys:String x:Key="LblSelectedDevice">Dispositivo: </sys:String>
    <sys:String x:Key="VadStatusText">VAD: esperando pausa...</sys:String>
    <sys:String x:Key="BtnCancelText">⛔ Cancelar procesamiento</sys:String>
    <sys:String x:Key="LblCancelled">⛔ Cancelado</sys:String>
    <sys:String x:Key="LblHistoryHeader">📋 Historial (clic para copiar):</sys:String>
    <sys:String x:Key="BtnClearHistoryTooltip">Limpiar historial</sys:String>
    <sys:String x:Key="CopyFeedbackText">✓ Copiado al portapapeles</sys:String>

    <!-- ══ Tray ══════════════════════════════════════════════════ -->
    <sys:String x:Key="TrayMenuControl">⚙️ Panel de control (F7)</sys:String>
    <sys:String x:Key="TrayMenuNotepad">📝 Bloc de notas (Ctrl+F7)</sys:String>
    <sys:String x:Key="TrayMenuExit">❌ Salir</sys:String>
    <sys:String x:Key="TrayIconText">Whisper Voice</sys:String>

    <!-- ══ MessageBox ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MsgLowResourcesTitle">⚠️ Recursos insuficientes</sys:String>
    <sys:String x:Key="MsgVramTitle">⚠️ VRAM</sys:String>
    <sys:String x:Key="MsgVramContinue">&#x0a;&#x0a;¿Continuar de todas formas?</sys:String>
    <sys:String x:Key="MsgWhisperErrorTitle">Error de Whisper</sys:String>
    <sys:String x:Key="MsgErrorTitle">Error</sys:String>
    <sys:String x:Key="MsgHallucinationFiltered">⚠️ Resultado filtrado</sys:String>
    <sys:String x:Key="MsgWhisperDone">✅ ¡Listo!</sys:String>
    <sys:String x:Key="MsgWhisperStarting">🔍 Iniciando Whisper...</sys:String>

    <!-- ══ SettingsWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="SettingsTitle">Configuración</sys:String>
    <sys:String x:Key="SettingsSectionLanguage">🌐 Idioma y modelo</sys:String>
    <sys:String x:Key="SettingsLblLanguage">Idioma para grabación primaria (Primary):</sys:String>
    <sys:String x:Key="SettingsLblLanguageTooltip">Seleccione idioma para la tecla primaria</sys:String>
    <sys:String x:Key="SettingsLblModel">🤖 Modelo Whisper:</sys:String>
    <sys:String x:Key="SettingsModelComboTooltip">Seleccione modelo de la carpeta /models</sys:String>
    <sys:String x:Key="SettingsBtnRefreshTooltip">Actualizar lista de modelos</sys:String>
    <sys:String x:Key="SettingsSectionVad">🎙️ VAD — Detección automática de silencio</sys:String>
    <sys:String x:Key="SettingsLblVadThreshold">Umbral de ruido (umbral → parar):</sys:String>
    <sys:String x:Key="SettingsHintVadThreshold">Menor = más sensible al silencio  |  Mayor = tolera ruido</sys:String>
    <sys:String x:Key="SettingsLblVadSilence">Pausa de silencio (segundos para parar):</sys:String>
    <sys:String x:Key="SettingsHintVadSilence">Duración del silencio antes de la detención automática</sys:String>
    <sys:String x:Key="SettingsSectionHotkeys">⌨️ Teclas de acceso rápido</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrimary">Grabación — idioma principal (Primary):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrimary">Tecla para iniciar/detener la grabación</sys:String>
    <sys:String x:Key="SettingsLblHotkeyTranslate">Grabación — traducir al inglés (Translate):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyTranslate">Tecla para grabación con traducción forzada al inglés</sys:String>
    <sys:String x:Key="SettingsSectionAppLanguage">🖥️ Idioma de la app</sys:String>
    <sys:String x:Key="SettingsLblAppLanguage">Idioma de la interfaz:</sys:String>
    <sys:String x:Key="SettingsLblAppLanguageTooltip">Cambia el idioma de la interfaz inmediatamente</sys:String>
    <sys:String x:Key="BtnSaveCloseText">💾 Guardar y cerrar</sys:String>
    <sys:String x:Key="BtnSaveCloseTooltip">Guardar todos los cambios y cerrar la ventana</sys:String>


    <!-- ══ Errors ══════════════════════════════════════════════════ -->
    <sys:String x:Key="ErrMicUnplugged">Micrófono no disponible o desconectado. Verifique la conexión.</sys:String>
    <!-- ══ WindowTitles ══════════════════════════════════════════════════ -->
    <sys:String x:Key="WindowTitleMicSelection">Seleccionar micrófono</sys:String>
    <sys:String x:Key="WindowTitleNotepad">Whisper: Bloc de notas</sys:String>
    <sys:String x:Key="WindowTitlePrompt">Diccionario (Tech Prompt)</sys:String>

    <!-- ══ MissingModelWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MissingModelTitle">⚠️ Modelo de IA no encontrado</sys:String>
    <sys:String x:Key="MissingModelBody">Modelo de IA no encontrado. Descargue el modelo e indique su ruta en Configuración.</sys:String>
    <sys:String x:Key="MissingModelDownloadBtn">⬇️ Descargar modelo (Hugging Face)</sys:String>
    <sys:String x:Key="MissingModelSettingsBtn">⚙️ Abrir configuración</sys:String>
    <sys:String x:Key="WindowTitleMissingModel">Modelo de IA no encontrado</sys:String>
</ResourceDictionary>