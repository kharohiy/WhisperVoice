<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══ MainWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="AppTitle">Whisper Control Panel</sys:String>
    <sys:String x:Key="MainHeaderText">⚙️ Configuración</sys:String>
    <sys:String x:Key="LblNoMicSelected">⚠️ ¡SELECCIONE UN MICRÓFONO!</sys:String>
    <sys:String x:Key="LblRecording">🔴 GRABANDO...</sys:String>
    <sys:String x:Key="LblProcessing">🧠 PROCESANDO...&#x0a;(Por favor espere)</sys:String>
    <sys:String x:Key="BtnSelectMicText">📋 Seleccionar micrófono (Lista)</sys:String>
    <sys:String x:Key="BtnPromptText">🏷️ Editor de diccionario (Prompt)</sys:String>
    <sys:String x:Key="BtnSettingsText">⚙️ Configuración</sys:String>
    <sys:String x:Key="BtnSettingsTooltip">Configuración de idioma, modelo, VAD y atajos</sys:String>
    <sys:String x:Key="BtnOpenNotepadText">📝 Abrir bloc de notas</sys:String>
    <sys:String x:Key="LblSignalLevel">Nivel de señal:</sys:String>
    <sys:String x:Key="LblMicVolume">Volumen del micrófono:</sys:String>
    <sys:String x:Key="LblSelectedDevice">Dispositivo: </sys:String>
    <sys:String x:Key="VadStatusText">VAD: esperando pausa...</sys:String>
    <sys:String x:Key="BtnCancelText">⛔ Cancelar procesamiento</sys:String>
    <sys:String x:Key="LblCancelled">⛔ Cancelado</sys:String>
    <sys:String x:Key="LblHistoryHeader">📋 Historial (clic para copiar):</sys:String>
    <sys:String x:Key="BtnClearHistoryTooltip">Limpiar historial</sys:String>
    <sys:String x:Key="CopyFeedbackText">✓ Copiado al portapapeles</sys:String>

    <!-- ══ Tray ══════════════════════════════════════════════════ -->
    <sys:String x:Key="TrayMenuControl">⚙️ Panel de control (F7)</sys:String>
    <sys:String x:Key="TrayMenuNotepad">📝 Bloc de notas (Ctrl+F7)</sys:String>
    <sys:String x:Key="TrayMenuExit">❌ Salir</sys:String>
    <sys:String x:Key="TrayIconText">Whisper Voice</sys:String>

    <!-- ══ MessageBox ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MsgLowResourcesTitle">⚠️ Recursos insuficientes</sys:String>
    <sys:String x:Key="MsgVramTitle">⚠️ VRAM</sys:String>
    <sys:String x:Key="MsgVramContinue">&#x0a;&#x0a;¿Continuar de todas formas?</sys:String>
    <sys:String x:Key="MsgWhisperErrorTitle">Error de Whisper</sys:String>
    <sys:String x:Key="MsgErrorTitle">Error</sys:String>
    <sys:String x:Key="MsgHallucinationFiltered">⚠️ Resultado filtrado</sys:String>
    <sys:String x:Key="MsgWhisperDone">✅ ¡Listo!</sys:String>
    <sys:String x:Key="MsgWhisperStarting">🔍 Iniciando Whisper...</sys:String>

    <!-- ══ SettingsWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="SettingsTitle">Configuración</sys:String>
    <sys:String x:Key="SettingsSectionLanguage">🌐 Idioma y modelo</sys:String>
    <sys:String x:Key="SettingsLblLanguage">Idioma para grabación primaria (Primary):</sys:String>
    <sys:String x:Key="SettingsLblLanguageTooltip">Seleccione idioma para la tecla primaria</sys:String>
    <sys:String x:Key="SettingsLblModel">🤖 Modelo Whisper:</sys:String>
    <sys:String x:Key="SettingsModelComboTooltip">Seleccione modelo de la carpeta /models</sys:String>
    <sys:String x:Key="SettingsBtnRefreshTooltip">Actualizar lista de modelos</sys:String>
    <sys:String x:Key="SettingsSectionVad">🎙️ VAD — Detección automática de silencio</sys:String>
    <sys:String x:Key="SettingsLblVadThreshold">Umbral de ruido (umbral → parar):</sys:String>
    <sys:String x:Key="SettingsHintVadThreshold">Menor = más sensible al silencio  |  Mayor = tolera ruido</sys:String>
    <sys:String x:Key="SettingsLblVadSilence">Pausa de silencio (segundos para parar):</sys:String>
    <sys:String x:Key="SettingsHintVadSilence">Duración del silencio antes de la detención automática</sys:String>
    <sys:String x:Key="SettingsSectionHotkeys">⌨️ Teclas de acceso rápido</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrimary">Grabación — idioma principal (Primary):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrimary">Tecla para iniciar/detener la grabación</sys:String>
    <sys:String x:Key="SettingsLblHotkeyTranslate">Grabación — traducir al inglés (Translate):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyTranslate">Tecla para grabación con traducción forzada al inglés</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrompt">Grabación — con prompt técnico (Prompt):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrompt">Tecla para grabación con prompt técnico</sys:String>
    <sys:String x:Key="SettingsSectionAppLanguage">🖥️ Idioma de la app</sys:String>
    <sys:String x:Key="SettingsLblAppLanguage">Idioma de la interfaz:</sys:String>
    <sys:String x:Key="SettingsLblAppLanguageTooltip">Cambia el idioma de la interfaz inmediatamente</sys:String>
    <sys:String x:Key="BtnSaveCloseText">💾 Guardar y cerrar</sys:String>
    <sys:String x:Key="BtnSaveCloseTooltip">Guardar todos los cambios y cerrar la ventana</sys:String>


    <!-- ══ Errors ══════════════════════════════════════════════════ -->
    <sys:String x:Key="ErrMicUnplugged">Micrófono no disponible o desconectado. Verifique la conexión.</sys:String>
    <!-- ══ WindowTitles ══════════════════════════════════════════════════ -->
    <sys:String x:Key="WindowTitleMicSelection">Seleccionar micrófono</sys:String>
    <sys:String x:Key="WindowTitleNotepad">Whisper: Bloc de notas</sys:String>
    <sys:String x:Key="WindowTitlePrompt">Diccionario (Tech Prompt)</sys:String>

    <!-- ══ MissingModelWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MissingModelTitle">⚠️ Modelo de IA no encontrado</sys:String>
    <sys:String x:Key="MissingModelBody">Modelo de IA no encontrado. Descargue el modelo e indique su ruta en Configuración.</sys:String>
    <sys:String x:Key="MissingModelDownloadBtn">⬇️ Descargar modelo (Hugging Face)</sys:String>
    <sys:String x:Key="MissingModelSettingsBtn">⚙️ Abrir configuración</sys:String>
    <sys:String x:Key="WindowTitleMissingModel">Modelo de IA no encontrado</sys:String>

    <!-- ══ HardwareCheckService ══════════════════════════════════════════ -->
    <sys:String x:Key="ErrLowRam">Memoria RAM insuficiente (se necesitan ≥ {0} MB libres).</sys:String>
    <sys:String x:Key="ErrLowVram">VRAM casi llena ({0} MB libres, se necesitan ≥ {1} MB).</sys:String>

    <!-- ══ SettingsWindow — MessageBoxes ════════════════════════════════ -->
    <sys:String x:Key="MsgModelExistsBody">El modelo '{0}' ya existe.&#x0a;¿Sobrescribir?</sys:String>
    <sys:String x:Key="MsgModelExistsTitle">Modelo existente</sys:String>
    <sys:String x:Key="MsgModelAddedBody">Modelo '{0}' añadido correctamente.</sys:String>
    <sys:String x:Key="MsgModelAddedTitle">Éxito</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedBody">Acceso denegado. Ejecute como administrador o elija otro destino.</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedTitle">Error</sys:String>
    <sys:String x:Key="MsgModelFailedBody">No se pudo añadir el modelo:&#x0a;{0}</sys:String>
    <sys:String x:Key="MsgModelFailedTitle">Error</sys:String>
    <sys:String x:Key="MsgModelLoadErrorAccess">Acceso denegado — compruebe los permisos</sys:String>
    <sys:String x:Key="MsgModelLoadError">Error: {0}</sys:String>
    <sys:String x:Key="MsgResetSlidersBody">¿Restablecer la configuración VAD y los parámetros de Whisper a los valores predeterminados?&#x0a;&#x0a;• Umbral de ruido → 5 %&#x0a;• Pausa de silencio → 1,8 s&#x0a;• Beam Size → 5&#x0a;• Best Of → 5&#x0a;• Temperature → 0,00&#x0a;• No-Speech Threshold → 0,60&#x0a;&#x0a;El idioma, el modelo, las teclas de acceso rápido y la configuración del sistema no cambiarán.</sys:String>
    <sys:String x:Key="MsgResetSlidersTitle">Restablecer configuración</sys:String>
    <sys:String x:Key="MsgInfoTitle">Información</sys:String>
    <sys:String x:Key="MsgUnhandledErrorBody">Error:&#x0a;{0}</sys:String>

    <!-- ══ SettingsWindow — VAD unit suffix ════════════════════════════ -->
    <sys:String x:Key="UnitSeconds"> s</sys:String>

    <!-- ══ Language display names (for UpdateLanguageButton) ═══════════ -->
    <sys:String x:Key="LangNameEn">Inglés</sys:String>
    <sys:String x:Key="LangNameRu">Ruso</sys:String>
    <sys:String x:Key="LangNameUk">Ucraniano</sys:String>
    <sys:String x:Key="LangNamePl">Polaco</sys:String>
    <sys:String x:Key="LangNameDe">Alemán</sys:String>
    <sys:String x:Key="LangNameEs">Español</sys:String>
    <sys:String x:Key="LangNameFr">Francés</sys:String>

    <!-- ══ MicWindow ══════════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnWinSoundText">⚙️ Configuración de sonido de Windows</sys:String>
    <sys:String x:Key="BtnSelectText">Seleccionar</sys:String>

    <!-- ══ PromptWindow ═══════════════════════════════════════════════════ -->
    <sys:String x:Key="PromptPrimaryLabel">Etiquetas de sugerencia para la red neuronal:</sys:String>
    <sys:String x:Key="PromptTranslateLabel">Prompt de traducción (se pasa a --prompt):</sys:String>
    <sys:String x:Key="BtnAddTagText">➕ Añadir</sys:String>
    <sys:String x:Key="BtnDeleteTagText">❌ Eliminar</sys:String>
    <sys:String x:Key="BtnPromptSaveText">💾 Guardar</sys:String>

    <!-- ══ NotepadWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnCopyAllText">📋 Copiar todo</sys:String>
    <sys:String x:Key="BtnClearAllText">🗑️ Borrar todo</sys:String>

    <!-- ══ SettingsWindow — Whisper Params section ════════════════════════ -->
    <sys:String x:Key="SettingsSectionWhisperParams">⚙️ Parámetros de Whisper</sys:String>
    <sys:String x:Key="SettingsHintBeamSize">Ancho de búsqueda (1 = ávido, 5 = predeterminado)</sys:String>
    <sys:String x:Key="SettingsHintBestOf">Candidatos con beam-size=1 (5 = predeterminado)</sys:String>
    <sys:String x:Key="SettingsWarnBestOf">⚠ Solo afecta cuando Temperature &gt; 0</sys:String>
    <sys:String x:Key="SettingsHintTemperature">0.0 = determinista, mayor = más creativo</sys:String>
    <sys:String x:Key="SettingsHintNoSpeech">Segmentos por debajo de este umbral = silencio (0.6 = predeterminado)</sys:String>

    <!-- ══ SettingsWindow — System section ════════════════════════════════ -->
    <sys:String x:Key="SettingsSectionSystem">🖥️ Sistema</sys:String>
    <sys:String x:Key="ChkRunAtStartupText">Ejecutar al iniciar Windows</sys:String>
    <sys:String x:Key="ChkSoundNotificationsText">Notificaciones de sonido (inicio / fin de grabación)</sys:String>

    <!-- ══ SettingsWindow — Push-to-Talk ════════════════════════════════ -->
    <sys:String x:Key="ChkPushToTalkText">Modo Push-to-Talk (mantener = grabar, soltar = parar)</sys:String>
    <sys:String x:Key="ChkPushToTalkTooltip">Mantén la tecla para grabar, suéltala para transcribir. Sustituye el modo alternado para las teclas Primary y Translate.</sys:String>
    <sys:String x:Key="ChkPushToTalkHint">Solo teclas Primary y Translate. Las teclas de Menú y Bloc de notas permanecen en modo alternado.</sys:String>
    <sys:String x:Key="BtnResetSlidersText">↺ Restablecer valores predeterminados</sys:String>
    <sys:String x:Key="BtnResetSlidersTooltip">Restablece el VAD (umbral de ruido, pausa de silencio) y los parámetros de Whisper (Beam Size, Best Of, Temperature, No-Speech Threshold). El idioma, el modelo, los atajos y la configuración del sistema no se ven afectados.</sys:String>

    <sys:String x:Key="ChkAutoClipboardText">Copiar automáticamente al portapapeles</sys:String>
    <sys:String x:Key="ChkAutoClipboardTooltip">Copiar automáticamente la transcripción y pegarla mediante Ctrl+V</sys:String>
    <sys:String x:Key="ChkAutoClipboardHint">Desactivar para mantener las transcripciones solo en el historial (modo de privacidad)</sys:String>
<sys:String x:Key="MsgVulkanCpuFallback">⚠️ Advertencia: la inferencia se ejecuta en la CPU. Compruebe el soporte de Vulkan.</sys:String>

    <sys:String x:Key="ModePushToTalk">Pulsar para hablar</sys:String>
    <sys:String x:Key="ModeToggle">Alternar</sys:String>
    <sys:String x:Key="ToolTipPrivacyPolicy">El audio se almacena temporalmente a nivel local antes de la transcripción y se elimina al salir.</sys:String>
</ResourceDictionary>
