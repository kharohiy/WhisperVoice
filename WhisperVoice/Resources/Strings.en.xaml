<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══ MainWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="AppTitle">Whisper Control Panel</sys:String>
    <sys:String x:Key="MainHeaderText">⚙️ Settings</sys:String>
    <sys:String x:Key="LblNoMicSelected">⚠️ SELECT A MICROPHONE!</sys:String>
    <sys:String x:Key="LblRecording">🔴 RECORDING...</sys:String>
    <sys:String x:Key="LblProcessing">🧠 PROCESSING...&#x0a;(Please wait)</sys:String>
    <sys:String x:Key="BtnSelectMicText">📋 Select Microphone (List)</sys:String>
    <sys:String x:Key="BtnPromptText">🏷️ Dictionary Editor (Prompt)</sys:String>
    <sys:String x:Key="BtnSettingsText">⚙️ Settings</sys:String>
    <sys:String x:Key="BtnSettingsTooltip">Language, model, VAD and hotkey settings</sys:String>
    <sys:String x:Key="BtnOpenNotepadText">📝 Open Notepad</sys:String>
    <sys:String x:Key="LblSignalLevel">Signal level:</sys:String>
    <sys:String x:Key="LblMicVolume">Microphone volume:</sys:String>
    <sys:String x:Key="LblSelectedDevice">Selected device: </sys:String>
    <sys:String x:Key="VadStatusText">VAD: waiting for pause...</sys:String>
    <sys:String x:Key="BtnCancelText">⛔ Cancel processing</sys:String>
    <sys:String x:Key="LblCancelled">⛔ Cancelled</sys:String>
    <sys:String x:Key="LblHistoryHeader">📋 History (click to copy):</sys:String>
    <sys:String x:Key="BtnClearHistoryTooltip">Clear history</sys:String>
    <sys:String x:Key="CopyFeedbackText">✓ Copied to clipboard</sys:String>

    <!-- ══ Tray ══════════════════════════════════════════════════ -->
    <sys:String x:Key="TrayMenuControl">⚙️ Control Panel (F7)</sys:String>
    <sys:String x:Key="TrayMenuNotepad">📝 Notepad (Ctrl+F7)</sys:String>
    <sys:String x:Key="TrayMenuExit">❌ Exit</sys:String>
    <sys:String x:Key="TrayIconText">Whisper Voice</sys:String>

    <!-- ══ MessageBox ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MsgLowResourcesTitle">⚠️ Insufficient resources</sys:String>
    <sys:String x:Key="MsgVramTitle">⚠️ VRAM</sys:String>
    <sys:String x:Key="MsgVramContinue">&#x0a;&#x0a;Continue anyway?</sys:String>
    <sys:String x:Key="MsgWhisperErrorTitle">Whisper Error</sys:String>
    <sys:String x:Key="MsgErrorTitle">Error</sys:String>
    <sys:String x:Key="MsgHallucinationFiltered">⚠️ Result filtered</sys:String>
    <sys:String x:Key="MsgWhisperDone">✅ Done!</sys:String>
    <sys:String x:Key="MsgWhisperStarting">🔍 Starting Whisper...</sys:String>

    <!-- ══ SettingsWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="SettingsTitle">Settings</sys:String>
    <sys:String x:Key="SettingsSectionLanguage">🌐 Language &amp; Model</sys:String>
    <sys:String x:Key="SettingsLblLanguage">Language for primary recording (Primary):</sys:String>
    <sys:String x:Key="SettingsLblLanguageTooltip">Select language for primary hotkey recording</sys:String>
    <sys:String x:Key="SettingsLblModel">🤖 Whisper Model:</sys:String>
    <sys:String x:Key="SettingsModelComboTooltip">Select model from /models folder</sys:String>
    <sys:String x:Key="SettingsBtnRefreshTooltip">Refresh model list</sys:String>
    <sys:String x:Key="SettingsSectionVad">🎙️ VAD — Silence Auto-Detection</sys:String>
    <sys:String x:Key="SettingsLblVadThreshold">Noise threshold (threshold → stop):</sys:String>
    <sys:String x:Key="SettingsHintVadThreshold">Lower = more sensitive to silence  |  Higher = tolerates noise</sys:String>
    <sys:String x:Key="SettingsLblVadSilence">Silence pause (seconds to stop):</sys:String>
    <sys:String x:Key="SettingsHintVadSilence">Duration of silence before auto-stop</sys:String>
    <sys:String x:Key="SettingsSectionHotkeys">⌨️ Hotkeys</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrimary">Record — primary language (Primary):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrimary">Key to start/stop recording in primary language</sys:String>
    <sys:String x:Key="SettingsLblHotkeyTranslate">Record — translate to English (Translate):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyTranslate">Key to record with forced English translation</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrompt">Record — with tech prompt (Prompt):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrompt">Key to record with forced technical prompt injection</sys:String>
    <sys:String x:Key="SettingsSectionAppLanguage">🖥️ App Language</sys:String>
    <sys:String x:Key="SettingsLblAppLanguage">Interface language:</sys:String>
    <sys:String x:Key="SettingsLblAppLanguageTooltip">Changes the app UI language immediately</sys:String>
    <sys:String x:Key="BtnSaveCloseText">💾 Save and Close</sys:String>
    <sys:String x:Key="BtnSaveCloseTooltip">Save all changes and close</sys:String>

    <!-- ══ SettingsWindow — Mic Test ════════════════════════════════════ -->
    <sys:String x:Key="SettingsLblMicTest">Mic Test (VU Meter)</sys:String>
    <sys:String x:Key="SettingsLblMicVolume">Microphone volume:</sys:String>
    <sys:String x:Key="BtnTestMicStart">🎙️ Start Test</sys:String>
    <sys:String x:Key="BtnTestMicStop">🛑 Stop Test</sys:String>
    <sys:String x:Key="ToolTipMicTest">Start/Stop microphone test</sys:String>


    <!-- ══ Errors ══════════════════════════════════════════════════ -->
    <sys:String x:Key="ErrMicUnplugged">Microphone unavailable or unplugged. Please check your connection.</sys:String>
    <!-- ══ WindowTitles ══════════════════════════════════════════════════ -->
    <sys:String x:Key="WindowTitleMicSelection">Select Microphone</sys:String>
    <sys:String x:Key="WindowTitleNotepad">Whisper: Notepad</sys:String>
    <sys:String x:Key="WindowTitlePrompt">Dictionary (Tech Prompt)</sys:String>

    <!-- ══ MissingModelWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MissingModelTitle">&#x26A0;&#xFE0F; AI Model Not Found</sys:String>
    <sys:String x:Key="MissingModelBody">AI Model not found. Please download the model and specify its path in Settings.</sys:String>
    <sys:String x:Key="MissingModelDownloadBtn">&#x2B07;&#xFE0F; Download Model (Hugging Face)</sys:String>
    <sys:String x:Key="MissingModelSettingsBtn">&#x2699;&#xFE0F; Open Settings</sys:String>
    <sys:String x:Key="WindowTitleMissingModel">AI Model Not Found</sys:String>

    <!-- ══ HardwareCheckService ══════════════════════════════════════════ -->
    <sys:String x:Key="ErrLowRam">Not enough RAM (need ≥ {0} MB free).</sys:String>
    <sys:String x:Key="ErrLowVram">VRAM almost full ({0} MB free, need ≥ {1} MB).</sys:String>

    <!-- ══ SettingsWindow — MessageBoxes ════════════════════════════════ -->
    <sys:String x:Key="MsgModelExistsBody">Model '{0}' already exists.&#x0a;Overwrite?</sys:String>
    <sys:String x:Key="MsgModelExistsTitle">Model exists</sys:String>
    <sys:String x:Key="MsgModelAddedBody">Model '{0}' added successfully.</sys:String>
    <sys:String x:Key="MsgModelAddedTitle">Success</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedBody">Access denied. Run as administrator or choose a different destination.</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedTitle">Error</sys:String>
    <sys:String x:Key="MsgModelFailedBody">Failed to add model:&#x0a;{0}</sys:String>
    <sys:String x:Key="MsgModelFailedTitle">Error</sys:String>
    <sys:String x:Key="MsgModelLoadErrorAccess">Access denied — check permissions</sys:String>
    <sys:String x:Key="MsgModelLoadError">Error: {0}</sys:String>
    <sys:String x:Key="MsgResetSlidersBody">Reset VAD settings and Whisper parameters to defaults?&#x0a;&#x0a;• Noise threshold → 5 %&#x0a;• Silence pause → 1.8 s&#x0a;• Beam Size → 5&#x0a;• Best Of → 5&#x0a;• Temperature → 0.00&#x0a;• No-Speech Threshold → 0.60&#x0a;&#x0a;Language, model, hotkeys and system settings will not change.</sys:String>
    <sys:String x:Key="MsgResetSlidersTitle">Reset settings</sys:String>
    <sys:String x:Key="MsgInfoTitle">Info</sys:String>
    <sys:String x:Key="MsgUnhandledErrorBody">Error:&#x0a;{0}</sys:String>

    <!-- ══ SettingsWindow — VAD unit suffix ════════════════════════════ -->
    <sys:String x:Key="UnitSeconds"> s</sys:String>

    <!-- ══ Language display names (for UpdateLanguageButton) ═══════════ -->
    <sys:String x:Key="LangNameEn">English</sys:String>
    <sys:String x:Key="LangNameRu">Russian</sys:String>
    <sys:String x:Key="LangNameUk">Ukrainian</sys:String>
    <sys:String x:Key="LangNamePl">Polish</sys:String>
    <sys:String x:Key="LangNameDe">German</sys:String>
    <sys:String x:Key="LangNameEs">Spanish</sys:String>
    <sys:String x:Key="LangNameFr">French</sys:String>

    <!-- ══ MicWindow ══════════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnWinSoundText">⚙️ Windows Sound Settings</sys:String>
    <sys:String x:Key="BtnSelectText">Select</sys:String>

    <!-- ══ PromptWindow ═══════════════════════════════════════════════════ -->
    <sys:String x:Key="PromptPrimaryLabel">Neural network hint tags:</sys:String>
    <sys:String x:Key="PromptTranslateLabel">Translation prompt (passed to --prompt):</sys:String>
    <sys:String x:Key="BtnAddTagText">➕ Add</sys:String>
    <sys:String x:Key="BtnDeleteTagText">❌ Remove</sys:String>
    <sys:String x:Key="BtnPromptSaveText">💾 Save</sys:String>

    <!-- ══ NotepadWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnCopyAllText">📋 Copy all</sys:String>
    <sys:String x:Key="BtnClearAllText">🗑️ Clear all</sys:String>

    <!-- ══ SettingsWindow — Whisper Params section ════════════════════════ -->
    <sys:String x:Key="SettingsSectionWhisperParams">⚙️ Whisper Parameters</sys:String>
    <sys:String x:Key="SettingsHintBeamSize">Search width (1 = greedy, 5 = default)</sys:String>
    <sys:String x:Key="SettingsHintBestOf">Candidates at beam-size=1 (5 = default)</sys:String>
    <sys:String x:Key="SettingsWarnBestOf">⚠ Only affects output when Temperature &gt; 0</sys:String>
    <sys:String x:Key="SettingsHintTemperature">0.0 = deterministic, higher = creative</sys:String>
    <sys:String x:Key="SettingsHintNoSpeech">Segments below this threshold = silence (0.6 = default)</sys:String>

    <!-- ══ SettingsWindow — System section ════════════════════════════════ -->
    <sys:String x:Key="SettingsSectionSystem">🖥️ System</sys:String>
    <sys:String x:Key="ChkRunAtStartupText">Run at Windows startup</sys:String>
    <sys:String x:Key="ChkSoundNotificationsText">Sound notifications (start / stop recording)</sys:String>

    <!-- ══ SettingsWindow — Push-to-Talk ════════════════════════════════ -->
    <sys:String x:Key="ChkPushToTalkText">Push-to-Talk mode (hold to record, release to stop)</sys:String>
    <sys:String x:Key="ChkPushToTalkTooltip">Hold the hotkey to record, release to transcribe. Replaces toggle behaviour for Primary and Translate keys only.</sys:String>
    <sys:String x:Key="ChkPushToTalkHint">Primary &amp; Translate keys only. Menu / Notepad keys stay in toggle mode.</sys:String>
    <sys:String x:Key="BtnResetSlidersText">↺ Reset to defaults</sys:String>
    <sys:String x:Key="BtnResetSlidersTooltip">Resets VAD (noise threshold, silence pause) and Whisper parameters (Beam Size, Best Of, Temperature, No-Speech Threshold). Language, model, hotkeys and system settings are not affected.</sys:String>
    <sys:String x:Key="ChkAutoClipboardText">Auto-copy to clipboard</sys:String>
    <sys:String x:Key="ChkAutoClipboardTooltip">Automatically copy transcription and paste it via Ctrl+V</sys:String>
    <sys:String x:Key="ChkAutoClipboardHint">Disable to keep transcriptions in history only (privacy mode)</sys:String>
<sys:String x:Key="MsgVulkanCpuFallback">⚠️ Warning: Inference is running on CPU. Check Vulkan support.</sys:String>

    <sys:String x:Key="ModePushToTalk">Push-To-Talk</sys:String>
    <sys:String x:Key="ModeToggle">Toggle</sys:String>
    <sys:String x:Key="ToolTipPrivacyPolicy">Audio is temporarily stored locally before transcription and deleted upon exit.</sys:String>

    <!-- ══ Hero Button ═══════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnHeroIdle">Record</sys:String>
    <sys:String x:Key="BtnHeroRecording">STOP</sys:String>
    <sys:String x:Key="BtnHeroProcessing">Processing...</sys:String>
    <!-- Settings Tabs -->
    <sys:String x:Key="SettingsTabGeneral">General</sys:String>
    <sys:String x:Key="SettingsTabAudio">Audio &amp; AI</sys:String>
    <sys:String x:Key="SettingsTabHotkeys">Hotkeys</sys:String>
    <sys:String x:Key="SettingsTabProfiles">Profiles</sys:String>

    <!-- Profiles Tab -->
    <sys:String x:Key="SettingsSectionProfiles">AI Profiles</sys:String>
    <sys:String x:Key="SettingsWarnProfilesModel">Profiles are optimized for large models (e.g. ggml-large-v3.bin). If you use a smaller model, you may experience hallucinations or ignored prompts. Tweak the Temperature manually if issues arise.</sys:String>
    <sys:String x:Key="SettingsLblProfileMapping">Hotkey Assignment</sys:String>
    <sys:String x:Key="SettingsLblProfilePrimary">Primary (Dictation):</sys:String>
    <sys:String x:Key="SettingsLblProfileTranslate">Translate to EN:</sys:String>
    <sys:String x:Key="SettingsLblProfilePrompt">Prompt (Tech):</sys:String>
    <sys:String x:Key="SettingsLblProfileEditor">Profile Editor</sys:String>
    <sys:String x:Key="SettingsLblProfileName">Profile Name:</sys:String>
    <sys:String x:Key="SettingsLblProfileTemperature">Temperature (Creativity):</sys:String>
    <sys:String x:Key="SettingsLblProfilePromptTags">Prompt Context (Comma separated):</sys:String>
    <sys:String x:Key="LblNoProfile">None (Standard Whisper)</sys:String>
</ResourceDictionary>
