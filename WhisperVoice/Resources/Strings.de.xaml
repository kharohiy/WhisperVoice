<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══ MainWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="AppTitle">Whisper Control Panel</sys:String>
    <sys:String x:Key="MainHeaderText">⚙️ Einstellungen</sys:String>
    <sys:String x:Key="LblNoMicSelected">⚠️ MIKROFON AUSWÄHLEN!</sys:String>
    <sys:String x:Key="LblRecording">🔴 AUFNAHME...</sys:String>
    <sys:String x:Key="LblProcessing">🧠 VERARBEITUNG...&#x0a;(Bitte warten)</sys:String>
    <sys:String x:Key="BtnSelectMicText">📋 Mikrofon auswählen (Liste)</sys:String>
    <sys:String x:Key="BtnPromptText">🏷️ Wörterbuch-Editor (Prompt)</sys:String>
    <sys:String x:Key="BtnSettingsText">⚙️ Einstellungen</sys:String>
    <sys:String x:Key="BtnSettingsTooltip">Sprache, Modell, VAD und Hotkey-Einstellungen</sys:String>
    <sys:String x:Key="BtnOpenNotepadText">📝 Notizblock öffnen</sys:String>
    <sys:String x:Key="LblSignalLevel">Signalpegel:</sys:String>
    <sys:String x:Key="LblMicVolume">Mikrofonlautstärke:</sys:String>
    <sys:String x:Key="LblSelectedDevice">Gerät: </sys:String>
    <sys:String x:Key="VadStatusText">VAD: warte auf Pause...</sys:String>
    <sys:String x:Key="BtnCancelText">⛔ Verarbeitung abbrechen</sys:String>
    <sys:String x:Key="LblCancelled">⛔ Abgebrochen</sys:String>
    <sys:String x:Key="LblHistoryHeader">📋 Verlauf (klicken zum Kopieren):</sys:String>
    <sys:String x:Key="BtnClearHistoryTooltip">Verlauf löschen</sys:String>
    <sys:String x:Key="CopyFeedbackText">✓ In Zwischenablage kopiert</sys:String>

    <!-- ══ Tray ══════════════════════════════════════════════════ -->
    <sys:String x:Key="TrayMenuControl">⚙️ Systemsteuerung (F7)</sys:String>
    <sys:String x:Key="TrayMenuNotepad">📝 Notizblock (Ctrl+F7)</sys:String>
    <sys:String x:Key="TrayMenuExit">❌ Beenden</sys:String>
    <sys:String x:Key="TrayIconText">Whisper Voice</sys:String>

    <!-- ══ MessageBox ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MsgLowResourcesTitle">⚠️ Zu wenig Ressourcen</sys:String>
    <sys:String x:Key="MsgVramTitle">⚠️ VRAM</sys:String>
    <sys:String x:Key="MsgVramContinue">&#x0a;&#x0a;Trotzdem fortfahren?</sys:String>
    <sys:String x:Key="MsgWhisperErrorTitle">Whisper-Fehler</sys:String>
    <sys:String x:Key="MsgErrorTitle">Fehler</sys:String>
    <sys:String x:Key="MsgHallucinationFiltered">⚠️ Ergebnis gefiltert</sys:String>
    <sys:String x:Key="MsgWhisperDone">✅ Fertig!</sys:String>
    <sys:String x:Key="MsgWhisperStarting">🔍 Whisper wird gestartet...</sys:String>

    <!-- ══ SettingsWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="SettingsTitle">Einstellungen</sys:String>
    <sys:String x:Key="SettingsSectionLanguage">🌐 Sprache &amp; Modell</sys:String>
    <sys:String x:Key="SettingsLblLanguage">Sprache für Hauptaufnahme (Primary):</sys:String>
    <sys:String x:Key="SettingsLblLanguageTooltip">Sprache für Haupthotkey-Aufnahme auswählen</sys:String>
    <sys:String x:Key="SettingsLblModel">🤖 Whisper-Modell:</sys:String>
    <sys:String x:Key="SettingsModelComboTooltip">Modell aus /models-Ordner auswählen</sys:String>
    <sys:String x:Key="SettingsBtnRefreshTooltip">Modellliste aktualisieren</sys:String>
    <sys:String x:Key="SettingsSectionVad">🎙️ VAD — Stille-Erkennung</sys:String>
    <sys:String x:Key="SettingsLblVadThreshold">Rauschschwelle (Schwelle → Stopp):</sys:String>
    <sys:String x:Key="SettingsHintVadThreshold">Niedriger = empfindlicher für Stille  |  Höher = toleriert Lärm</sys:String>
    <sys:String x:Key="SettingsLblVadSilence">Stille-Pause (Sekunden bis Stopp):</sys:String>
    <sys:String x:Key="SettingsHintVadSilence">Stille-Dauer vor automatischem Stopp</sys:String>
    <sys:String x:Key="SettingsSectionHotkeys">⌨️ Tastenkürzel</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrimary">Aufnahme — Hauptsprache (Primary):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrimary">Taste zum Starten/Stoppen der Aufnahme</sys:String>
    <sys:String x:Key="SettingsLblHotkeyTranslate">Aufnahme — Übersetzung ins Englische:</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyTranslate">Taste für Aufnahme mit erzwungener englischer Übersetzung</sys:String>
    <sys:String x:Key="SettingsSectionAppLanguage">🖥️ App-Sprache</sys:String>
    <sys:String x:Key="SettingsLblAppLanguage">Oberflächensprache:</sys:String>
    <sys:String x:Key="SettingsLblAppLanguageTooltip">Ändert die App-Sprache sofort</sys:String>
    <sys:String x:Key="BtnSaveCloseText">💾 Speichern und schließen</sys:String>
    <sys:String x:Key="BtnSaveCloseTooltip">Alle Änderungen speichern und Fenster schließen</sys:String>


    <!-- ══ Errors ══════════════════════════════════════════════════ -->
    <sys:String x:Key="ErrMicUnplugged">Mikrofon nicht verfügbar oder getrennt. Bitte Verbindung prüfen.</sys:String>
    <!-- ══ WindowTitles ══════════════════════════════════════════════════ -->
    <sys:String x:Key="WindowTitleMicSelection">Mikrofon auswählen</sys:String>
    <sys:String x:Key="WindowTitleNotepad">Whisper: Notizblock</sys:String>
    <sys:String x:Key="WindowTitlePrompt">Wörterbuch (Tech Prompt)</sys:String>

    <!-- ══ MissingModelWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MissingModelTitle">⚠️ KI-Modell nicht gefunden</sys:String>
    <sys:String x:Key="MissingModelBody">KI-Modell nicht gefunden. Laden Sie das Modell herunter und geben Sie den Pfad in den Einstellungen an.</sys:String>
    <sys:String x:Key="MissingModelDownloadBtn">⬇️ Modell herunterladen (Hugging Face)</sys:String>
    <sys:String x:Key="MissingModelSettingsBtn">⚙️ Einstellungen öffnen</sys:String>
    <sys:String x:Key="WindowTitleMissingModel">KI-Modell nicht gefunden</sys:String>
</ResourceDictionary>