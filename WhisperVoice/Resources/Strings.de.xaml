<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══ MainWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="AppTitle">Whisper Control Panel</sys:String>
    <sys:String x:Key="MainHeaderText">⚙️ Einstellungen</sys:String>
    <sys:String x:Key="LblNoMicSelected">⚠️ MIKROFON AUSWÄHLEN!</sys:String>
    <sys:String x:Key="LblRecording">🔴 AUFNAHME...</sys:String>
    <sys:String x:Key="LblProcessing">🧠 VERARBEITUNG...&#x0a;(Bitte warten)</sys:String>
    <sys:String x:Key="BtnSelectMicText">📋 Mikrofon auswählen (Liste)</sys:String>
    <sys:String x:Key="BtnPromptText">🏷️ Wörterbuch-Editor (Prompt)</sys:String>
    <sys:String x:Key="BtnSettingsText">⚙️ Einstellungen</sys:String>
    <sys:String x:Key="BtnSettingsTooltip">Sprache, Modell, VAD und Hotkey-Einstellungen</sys:String>
    <sys:String x:Key="BtnOpenNotepadText">📝 Notizblock öffnen</sys:String>
    <sys:String x:Key="LblSignalLevel">Signalpegel:</sys:String>
    <sys:String x:Key="LblMicVolume">Mikrofonlautstärke:</sys:String>
    <sys:String x:Key="LblSelectedDevice">Gerät: </sys:String>
    <sys:String x:Key="VadStatusText">VAD: warte auf Pause...</sys:String>
    <sys:String x:Key="BtnCancelText">⛔ Verarbeitung abbrechen</sys:String>
    <sys:String x:Key="LblCancelled">⛔ Abgebrochen</sys:String>
    <sys:String x:Key="LblHistoryHeader">📋 Verlauf (klicken zum Kopieren):</sys:String>
    <sys:String x:Key="BtnClearHistoryTooltip">Verlauf löschen</sys:String>
    <sys:String x:Key="CopyFeedbackText">✓ In Zwischenablage kopiert</sys:String>

    <!-- ══ Tray ══════════════════════════════════════════════════ -->
    <sys:String x:Key="TrayMenuControl">⚙️ Systemsteuerung (F7)</sys:String>
    <sys:String x:Key="TrayMenuNotepad">📝 Notizblock (Ctrl+F7)</sys:String>
    <sys:String x:Key="TrayMenuExit">❌ Beenden</sys:String>
    <sys:String x:Key="TrayIconText">Whisper Voice</sys:String>

    <!-- ══ MessageBox ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MsgLowResourcesTitle">⚠️ Zu wenig Ressourcen</sys:String>
    <sys:String x:Key="MsgVramTitle">⚠️ VRAM</sys:String>
    <sys:String x:Key="MsgVramContinue">&#x0a;&#x0a;Trotzdem fortfahren?</sys:String>
    <sys:String x:Key="MsgWhisperErrorTitle">Whisper-Fehler</sys:String>
    <sys:String x:Key="MsgErrorTitle">Fehler</sys:String>
    <sys:String x:Key="MsgHallucinationFiltered">⚠️ Ergebnis gefiltert</sys:String>
    <sys:String x:Key="MsgWhisperDone">✅ Fertig!</sys:String>
    <sys:String x:Key="MsgWhisperStarting">🔍 Whisper wird gestartet...</sys:String>

    <!-- ══ SettingsWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="SettingsTitle">Einstellungen</sys:String>
    <sys:String x:Key="SettingsSectionLanguage">🌐 Sprache &amp; Modell</sys:String>
    <sys:String x:Key="SettingsLblLanguage">Sprache für Hauptaufnahme (Primary):</sys:String>
    <sys:String x:Key="SettingsLblLanguageTooltip">Sprache für Haupthotkey-Aufnahme auswählen</sys:String>
    <sys:String x:Key="SettingsLblModel">🤖 Whisper-Modell:</sys:String>
    <sys:String x:Key="SettingsModelComboTooltip">Modell aus /models-Ordner auswählen</sys:String>
    <sys:String x:Key="SettingsBtnRefreshTooltip">Modellliste aktualisieren</sys:String>
    <sys:String x:Key="SettingsSectionVad">🎙️ VAD — Stille-Erkennung</sys:String>
    <sys:String x:Key="SettingsLblVadThreshold">Rauschschwelle (Schwelle → Stopp):</sys:String>
    <sys:String x:Key="SettingsHintVadThreshold">Niedriger = empfindlicher für Stille  |  Höher = toleriert Lärm</sys:String>
    <sys:String x:Key="SettingsLblVadSilence">Stille-Pause (Sekunden bis Stopp):</sys:String>
    <sys:String x:Key="SettingsHintVadSilence">Stille-Dauer vor automatischem Stopp</sys:String>
    <sys:String x:Key="SettingsSectionHotkeys">⌨️ Tastenkürzel</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrimary">Aufnahme — Hauptsprache (Primary):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrimary">Taste zum Starten/Stoppen der Aufnahme</sys:String>
    <sys:String x:Key="SettingsLblHotkeyTranslate">Aufnahme — Übersetzung ins Englische:</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyTranslate">Taste für Aufnahme mit erzwungener englischer Übersetzung</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrompt">Aufnahme — mit Tech-Prompt (Prompt):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrompt">Taste für Aufnahme mit technischem Prompt</sys:String>
    <sys:String x:Key="SettingsSectionAppLanguage">🖥️ App-Sprache</sys:String>
    <sys:String x:Key="SettingsLblAppLanguage">Oberflächensprache:</sys:String>
    <sys:String x:Key="SettingsLblAppLanguageTooltip">Ändert die App-Sprache sofort</sys:String>
    <sys:String x:Key="BtnSaveCloseText">💾 Speichern und schließen</sys:String>
    <sys:String x:Key="BtnSaveCloseTooltip">Alle Änderungen speichern und Fenster schließen</sys:String>


    <!-- ══ Errors ══════════════════════════════════════════════════ -->
    <sys:String x:Key="ErrMicUnplugged">Mikrofon nicht verfügbar oder getrennt. Bitte Verbindung prüfen.</sys:String>
    <!-- ══ WindowTitles ══════════════════════════════════════════════════ -->
    <sys:String x:Key="WindowTitleMicSelection">Mikrofon auswählen</sys:String>
    <sys:String x:Key="WindowTitleNotepad">Whisper: Notizblock</sys:String>
    <sys:String x:Key="WindowTitlePrompt">Wörterbuch (Tech Prompt)</sys:String>

    <!-- ══ MissingModelWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MissingModelTitle">⚠️ KI-Modell nicht gefunden</sys:String>
    <sys:String x:Key="MissingModelBody">KI-Modell nicht gefunden. Laden Sie das Modell herunter und geben Sie den Pfad in den Einstellungen an.</sys:String>
    <sys:String x:Key="MissingModelDownloadBtn">⬇️ Modell herunterladen (Hugging Face)</sys:String>
    <sys:String x:Key="MissingModelSettingsBtn">⚙️ Einstellungen öffnen</sys:String>
    <sys:String x:Key="WindowTitleMissingModel">KI-Modell nicht gefunden</sys:String>

    <!-- ══ HardwareCheckService ══════════════════════════════════════════ -->
    <sys:String x:Key="ErrLowRam">Nicht genug RAM (benötigt ≥ {0} MB frei).</sys:String>
    <sys:String x:Key="ErrLowVram">VRAM fast voll ({0} MB frei, benötigt ≥ {1} MB).</sys:String>

    <!-- ══ SettingsWindow — MessageBoxes ════════════════════════════════ -->
    <sys:String x:Key="MsgModelExistsBody">Modell '{0}' existiert bereits.&#x0a;Überschreiben?</sys:String>
    <sys:String x:Key="MsgModelExistsTitle">Modell vorhanden</sys:String>
    <sys:String x:Key="MsgModelAddedBody">Modell '{0}' erfolgreich hinzugefügt.</sys:String>
    <sys:String x:Key="MsgModelAddedTitle">Erfolg</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedBody">Zugriff verweigert. Als Administrator ausführen oder anderen Zielordner wählen.</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedTitle">Fehler</sys:String>
    <sys:String x:Key="MsgModelFailedBody">Modell konnte nicht hinzugefügt werden:&#x0a;{0}</sys:String>
    <sys:String x:Key="MsgModelFailedTitle">Fehler</sys:String>
    <sys:String x:Key="MsgModelLoadErrorAccess">Zugriff verweigert — Berechtigungen prüfen</sys:String>
    <sys:String x:Key="MsgModelLoadError">Fehler: {0}</sys:String>
    <sys:String x:Key="MsgResetSlidersBody">VAD-Einstellungen und Whisper-Parameter auf Standardwerte zurücksetzen?&#x0a;&#x0a;• Rauschschwelle → 5 %&#x0a;• Stillepause → 1,8 s&#x0a;• Beam Size → 5&#x0a;• Best Of → 5&#x0a;• Temperature → 0,00&#x0a;• No-Speech Threshold → 0,60&#x0a;&#x0a;Sprache, Modell, Hotkeys und Systemeinstellungen bleiben unverändert.</sys:String>
    <sys:String x:Key="MsgResetSlidersTitle">Einstellungen zurücksetzen</sys:String>
    <sys:String x:Key="MsgInfoTitle">Info</sys:String>
    <sys:String x:Key="MsgUnhandledErrorBody">Fehler:&#x0a;{0}</sys:String>

    <!-- ══ SettingsWindow — VAD unit suffix ════════════════════════════ -->
    <sys:String x:Key="UnitSeconds"> s</sys:String>

    <!-- ══ Language display names (for UpdateLanguageButton) ═══════════ -->
    <sys:String x:Key="LangNameEn">Englisch</sys:String>
    <sys:String x:Key="LangNameRu">Russisch</sys:String>
    <sys:String x:Key="LangNameUk">Ukrainisch</sys:String>
    <sys:String x:Key="LangNamePl">Polnisch</sys:String>
    <sys:String x:Key="LangNameDe">Deutsch</sys:String>
    <sys:String x:Key="LangNameEs">Spanisch</sys:String>
    <sys:String x:Key="LangNameFr">Französisch</sys:String>

    <!-- ══ MicWindow ══════════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnWinSoundText">⚙️ Windows-Soundeinstellungen</sys:String>
    <sys:String x:Key="BtnSelectText">Auswählen</sys:String>

    <!-- ══ PromptWindow ═══════════════════════════════════════════════════ -->
    <sys:String x:Key="PromptPrimaryLabel">Hinweis-Tags für das neuronale Netz:</sys:String>
    <sys:String x:Key="PromptTranslateLabel">Übersetzungsprompt (wird an --prompt übergeben):</sys:String>
    <sys:String x:Key="BtnAddTagText">➕ Hinzufügen</sys:String>
    <sys:String x:Key="BtnDeleteTagText">❌ Entfernen</sys:String>
    <sys:String x:Key="BtnPromptSaveText">💾 Speichern</sys:String>

    <!-- ══ NotepadWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnCopyAllText">📋 Alles kopieren</sys:String>
    <sys:String x:Key="BtnClearAllText">🗑️ Alles löschen</sys:String>

    <!-- ══ SettingsWindow — Whisper Params section ════════════════════════ -->
    <sys:String x:Key="SettingsSectionWhisperParams">⚙️ Whisper-Parameter</sys:String>
    <sys:String x:Key="SettingsHintBeamSize">Suchbreite (1 = gierig, 5 = Standard)</sys:String>
    <sys:String x:Key="SettingsHintBestOf">Kandidaten bei beam-size=1 (5 = Standard)</sys:String>
    <sys:String x:Key="SettingsWarnBestOf">⚠ Wirkt nur bei Temperature &gt; 0</sys:String>
    <sys:String x:Key="SettingsHintTemperature">0.0 = deterministisch, höher = kreativer</sys:String>
    <sys:String x:Key="SettingsHintNoSpeech">Segmente unter diesem Schwellenwert = Stille (0.6 = Standard)</sys:String>

    <!-- ══ SettingsWindow — System section ════════════════════════════════ -->
    <sys:String x:Key="SettingsSectionSystem">🖥️ System</sys:String>
    <sys:String x:Key="ChkRunAtStartupText">Mit Windows starten</sys:String>
    <sys:String x:Key="ChkSoundNotificationsText">Soundbenachrichtigungen (Start / Stopp der Aufnahme)</sys:String>

    <!-- ══ SettingsWindow — Push-to-Talk ════════════════════════════════ -->
    <sys:String x:Key="ChkPushToTalkText">Push-to-Talk-Modus (halten = aufnehmen, loslassen = stopp)</sys:String>
    <sys:String x:Key="ChkPushToTalkTooltip">Taste gedrückt halten zum Aufnehmen, loslassen zum Transkribieren. Ersetzt den Umschaltmodus für Primary- und Translate-Tasten.</sys:String>
    <sys:String x:Key="ChkPushToTalkHint">Nur Primary- und Translate-Tasten. Menü- und Notizbuch-Tasten bleiben im Umschaltmodus.</sys:String>
    <sys:String x:Key="BtnResetSlidersText">↺ Auf Standardwerte zurücksetzen</sys:String>
    <sys:String x:Key="BtnResetSlidersTooltip">Setzt VAD (Rauschschwelle, Stillepause) und Whisper-Parameter (Beam Size, Best Of, Temperature, No-Speech Threshold) zurück. Sprache, Modell, Hotkeys und Systemeinstellungen bleiben unverändert.</sys:String>

    <sys:String x:Key="ChkAutoClipboardText">Automatisches Kopieren in die Zwischenablage</sys:String>
    <sys:String x:Key="ChkAutoClipboardTooltip">Transkription automatisch kopieren und mit Strg+V einfügen</sys:String>
    <sys:String x:Key="ChkAutoClipboardHint">Deaktivieren, um Transkriptionen nur im Verlauf zu speichern (Datenschutzmodus)</sys:String>
<sys:String x:Key="MsgVulkanCpuFallback">⚠️ Warnung: Inferenz läuft auf CPU. Vulkan-Unterstützung prüfen.</sys:String>

    <sys:String x:Key="ModePushToTalk">Push-To-Talk</sys:String>
    <sys:String x:Key="ModeToggle">Umschalten</sys:String>
    <sys:String x:Key="ToolTipPrivacyPolicy">Audio wird vor der Transkription vorübergehend lokal gespeichert und beim Beenden gelöscht.</sys:String>

    <!-- ══ Hero Button ═══════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnHeroIdle">Aufnehmen</sys:String>
    <sys:String x:Key="BtnHeroRecording">STOPP</sys:String>
    <sys:String x:Key="BtnHeroProcessing">Verarbeitung...</sys:String>
    <!-- Settings Tabs -->
    <sys:String x:Key="SettingsTabGeneral">Allgemein</sys:String>
    <sys:String x:Key="SettingsTabAudio">Audio &amp; KI</sys:String>
    <sys:String x:Key="SettingsTabHotkeys">Tastenkombinationen</sys:String>
</ResourceDictionary>
