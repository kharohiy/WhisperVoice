<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══ MainWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="AppTitle">Whisper Control Panel</sys:String>
    <sys:String x:Key="MainHeaderText">⚙️ Настройки</sys:String>
    <sys:String x:Key="LblNoMicSelected">⚠️ ВЫБЕРИТЕ МИКРОФОН!</sys:String>
    <sys:String x:Key="LblRecording">🔴 ЗАПИСЬ...</sys:String>
    <sys:String x:Key="LblProcessing">🧠 ОБРАБОТКА...&#x0a;(Подождите)</sys:String>
    <sys:String x:Key="BtnSelectMicText">📋 Выбрать микрофон (Список)</sys:String>
    <sys:String x:Key="BtnPromptText">🏷️ Редактор словаря (Prompt)</sys:String>
    <sys:String x:Key="BtnSettingsText">⚙️ Настройки</sys:String>
    <sys:String x:Key="BtnSettingsTooltip">Настройки языка, модели, VAD и горячих клавиш</sys:String>
    <sys:String x:Key="BtnOpenNotepadText">📝 Открыть Блокнот (Notepad)</sys:String>
    <sys:String x:Key="LblSignalLevel">Уровень сигнала:</sys:String>
    <sys:String x:Key="LblMicVolume">Громкость микрофона:</sys:String>
    <sys:String x:Key="LblSelectedDevice">Устройство: </sys:String>
    <sys:String x:Key="VadStatusText">VAD: ожидание паузы...</sys:String>
    <sys:String x:Key="BtnCancelText">⛔ Отменить обработку</sys:String>
    <sys:String x:Key="LblCancelled">⛔ Отменено</sys:String>
    <sys:String x:Key="LblHistoryHeader">📋 История (нажми — скопировать):</sys:String>
    <sys:String x:Key="BtnClearHistoryTooltip">Очистить историю</sys:String>
    <sys:String x:Key="CopyFeedbackText">✓ Скопировано в буфер</sys:String>

    <!-- ══ Tray ══════════════════════════════════════════════════ -->
    <sys:String x:Key="TrayMenuControl">⚙️ Панель управления (F7)</sys:String>
    <sys:String x:Key="TrayMenuNotepad">📝 Блокнот (Ctrl+F7)</sys:String>
    <sys:String x:Key="TrayMenuExit">❌ Выход</sys:String>
    <sys:String x:Key="TrayIconText">Whisper Voice</sys:String>

    <!-- ══ MessageBox ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MsgLowResourcesTitle">⚠️ Недостаточно ресурсов</sys:String>
    <sys:String x:Key="MsgVramTitle">⚠️ VRAM</sys:String>
    <sys:String x:Key="MsgVramContinue">&#x0a;&#x0a;Продолжить всё равно?</sys:String>
    <sys:String x:Key="MsgWhisperErrorTitle">Ошибка Whisper</sys:String>
    <sys:String x:Key="MsgErrorTitle">Ошибка</sys:String>
    <sys:String x:Key="MsgHallucinationFiltered">⚠️ Результат отфильтрован</sys:String>
    <sys:String x:Key="MsgWhisperDone">✅ Готово!</sys:String>
    <sys:String x:Key="MsgWhisperStarting">🔍 Запуск Whisper...</sys:String>

    <!-- ══ SettingsWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="SettingsTitle">Параметры</sys:String>
    <sys:String x:Key="SettingsSectionLanguage">🌐 Язык и модель</sys:String>
    <sys:String x:Key="SettingsLblLanguage">Язык для основной записи (Primary):</sys:String>
    <sys:String x:Key="SettingsLblLanguageTooltip">Выберите язык для записи основной горячей клавишей</sys:String>
    <sys:String x:Key="SettingsLblModel">🤖 Модель Whisper:</sys:String>
    <sys:String x:Key="SettingsModelComboTooltip">Выберите модель из папки /models</sys:String>
    <sys:String x:Key="SettingsBtnRefreshTooltip">Обновить список моделей</sys:String>
    <sys:String x:Key="SettingsSectionVad">🎙️ VAD — Автодетекция тишины</sys:String>
    <sys:String x:Key="SettingsLblVadThreshold">Порог шума (порог → стоп):</sys:String>
    <sys:String x:Key="SettingsHintVadThreshold">Меньше = чувствительнее к тишине  |  Больше = терпит шум</sys:String>
    <sys:String x:Key="SettingsLblVadSilence">Пауза тишины (секунд до стопа):</sys:String>
    <sys:String x:Key="SettingsHintVadSilence">Длительность тишины перед автоматической остановкой записи</sys:String>
    <sys:String x:Key="SettingsSectionHotkeys">⌨️ Горячие клавиши</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrimary">Запись — основной язык (Primary):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrimary">Клавиша для запуска/остановки записи на основном языке</sys:String>
    <sys:String x:Key="SettingsLblHotkeyTranslate">Запись — перевод на English (Translate):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyTranslate">Клавиша для записи с принудительным переводом на английский</sys:String>
    <sys:String x:Key="SettingsSectionAppLanguage">🖥️ Язык интерфейса</sys:String>
    <sys:String x:Key="SettingsLblAppLanguage">Язык интерфейса приложения:</sys:String>
    <sys:String x:Key="SettingsLblAppLanguageTooltip">Мгновенно меняет язык интерфейса</sys:String>
    <sys:String x:Key="BtnSaveCloseText">💾 Сохранить и закрыть</sys:String>
    <sys:String x:Key="BtnSaveCloseTooltip">Сохранить все изменения и закрыть окно</sys:String>


    <!-- ══ Errors ══════════════════════════════════════════════════ -->
    <sys:String x:Key="ErrMicUnplugged">Микрофон недоступен или отключён. Проверьте подключение.</sys:String>
    <!-- ══ WindowTitles ══════════════════════════════════════════════════ -->
    <sys:String x:Key="WindowTitleMicSelection">Выберите микрофон</sys:String>
    <sys:String x:Key="WindowTitleNotepad">Whisper: Блокнот</sys:String>
    <sys:String x:Key="WindowTitlePrompt">Словарь (Tech Prompt)</sys:String>

    <!-- ══ MissingModelWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MissingModelTitle">⚠️ Модель ИИ не найдена</sys:String>
    <sys:String x:Key="MissingModelBody">Модель ИИ не найдена. Скачайте модель и укажите путь к ней в Настройках.</sys:String>
    <sys:String x:Key="MissingModelDownloadBtn">⬇️ Скачать модель (Hugging Face)</sys:String>
    <sys:String x:Key="MissingModelSettingsBtn">⚙️ Открыть настройки</sys:String>
    <sys:String x:Key="WindowTitleMissingModel">Модель ИИ не найдена</sys:String>

    <!-- ══ HardwareCheckService ══════════════════════════════════════════ -->
    <sys:String x:Key="ErrLowRam">Недостаточно оперативной памяти (нужно ≥ {0} МБ свободно).</sys:String>
    <sys:String x:Key="ErrLowVram">VRAM почти заполнена ({0} МБ свободно, нужно ≥ {1} МБ).</sys:String>

    <!-- ══ SettingsWindow — MessageBoxes ════════════════════════════════ -->
    <sys:String x:Key="MsgModelExistsBody">Модель '{0}' уже существует.&#x0a;Перезаписать?</sys:String>
    <sys:String x:Key="MsgModelExistsTitle">Модель существует</sys:String>
    <sys:String x:Key="MsgModelAddedBody">Модель '{0}' успешно добавлена.</sys:String>
    <sys:String x:Key="MsgModelAddedTitle">Успех</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedBody">Доступ запрещён. Запустите от имени администратора или выберите другую папку.</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedTitle">Ошибка</sys:String>
    <sys:String x:Key="MsgModelFailedBody">Не удалось добавить модель:&#x0a;{0}</sys:String>
    <sys:String x:Key="MsgModelFailedTitle">Ошибка</sys:String>
    <sys:String x:Key="MsgModelLoadErrorAccess">Доступ запрещён — проверьте права</sys:String>
    <sys:String x:Key="MsgModelLoadError">Ошибка: {0}</sys:String>
    <sys:String x:Key="MsgResetSlidersBody">Сбросить настройки VAD и параметры Whisper к значениям по умолчанию?&#x0a;&#x0a;• Порог шума → 5 %&#x0a;• Пауза тишины → 1,8 с&#x0a;• Beam Size → 5&#x0a;• Best Of → 5&#x0a;• Temperature → 0,00&#x0a;• No-Speech Threshold → 0,60&#x0a;&#x0a;Язык, модель, горячие клавиши и системные настройки не изменятся.</sys:String>
    <sys:String x:Key="MsgResetSlidersTitle">Сброс настроек</sys:String>
    <sys:String x:Key="MsgInfoTitle">Информация</sys:String>
    <sys:String x:Key="MsgUnhandledErrorBody">Ошибка:&#x0a;{0}</sys:String>

    <!-- ══ SettingsWindow — VAD unit suffix ════════════════════════════ -->
    <sys:String x:Key="UnitSeconds"> с</sys:String>

    <!-- ══ Language display names (for UpdateLanguageButton) ═══════════ -->
    <sys:String x:Key="LangNameEn">Английский</sys:String>
    <sys:String x:Key="LangNameRu">Русский</sys:String>
    <sys:String x:Key="LangNameUk">Украинский</sys:String>
    <sys:String x:Key="LangNamePl">Польский</sys:String>
    <sys:String x:Key="LangNameDe">Немецкий</sys:String>
    <sys:String x:Key="LangNameEs">Испанский</sys:String>
    <sys:String x:Key="LangNameFr">Французский</sys:String>

    <!-- ══ MicWindow ══════════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnWinSoundText">⚙️ Настройки звука Windows</sys:String>
    <sys:String x:Key="BtnSelectText">Выбрать</sys:String>

    <!-- ══ PromptWindow ═══════════════════════════════════════════════════ -->
    <sys:String x:Key="PromptPrimaryLabel">Теги-подсказки для нейросети:</sys:String>
    <sys:String x:Key="PromptTranslateLabel">Промпт для перевода (передаётся в --prompt):</sys:String>
    <sys:String x:Key="BtnAddTagText">➕ Добавить</sys:String>
    <sys:String x:Key="BtnDeleteTagText">❌ Удалить</sys:String>
    <sys:String x:Key="BtnPromptSaveText">💾 Сохранить</sys:String>

    <!-- ══ NotepadWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnCopyAllText">📋 Копировать всё</sys:String>
    <sys:String x:Key="BtnClearAllText">🗑️ Стереть всё</sys:String>

    <!-- ══ SettingsWindow — Whisper Params section ════════════════════════ -->
    <sys:String x:Key="SettingsSectionWhisperParams">⚙️ Параметры Whisper</sys:String>
    <sys:String x:Key="SettingsHintBeamSize">Ширина поиска (1 = жадный, 5 = по умолчанию)</sys:String>
    <sys:String x:Key="SettingsHintBestOf">Кандидаты при beam-size=1 (5 = по умолчанию)</sys:String>
    <sys:String x:Key="SettingsWarnBestOf">⚠ Влияет только при Temperature &gt; 0</sys:String>
    <sys:String x:Key="SettingsHintTemperature">0.0 = детерминированный, выше = творческий</sys:String>
    <sys:String x:Key="SettingsHintNoSpeech">Сегменты ниже этого порога = тишина (0.6 = по умолчанию)</sys:String>

    <!-- ══ SettingsWindow — System section ════════════════════════════════ -->
    <sys:String x:Key="SettingsSectionSystem">🖥️ Система</sys:String>
    <sys:String x:Key="ChkRunAtStartupText">Запускать с Windows</sys:String>
    <sys:String x:Key="ChkSoundNotificationsText">Звуковые уведомления (старт / стоп записи)</sys:String>
    <sys:String x:Key="BtnResetSlidersText">↺ Сбросить настройки по умолчанию</sys:String>
    <sys:String x:Key="BtnResetSlidersTooltip">Сбрасывает VAD (порог шума, пауза тишины) и параметры Whisper (Beam Size, Best Of, Temperature, No-Speech Threshold). Язык, модель, горячие клавиши и системные настройки не затрагиваются.</sys:String>
</ResourceDictionary>