    <sys:String x:Key="WizardStep3Desc">WhisperVoice needs an AI model to transcribe speech. We have analyzed your hardware and recommend a model below.</sys:String>
    <sys:String x:Key="WizardHardwareTitle">Your Hardware</sys:String>
    <sys:String x:Key="WizardAdvisorModelRec">Recommended Model: </sys:String>
