<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══ MainWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="AppTitle">Whisper Control Panel</sys:String>
    <sys:String x:Key="MainHeaderText">⚙️ Paramètres</sys:String>
    <sys:String x:Key="LblNoMicSelected">⚠️ SÉLECTIONNEZ UN MICRO !</sys:String>
    <sys:String x:Key="LblRecording">🔴 ENREGISTREMENT...</sys:String>
    <sys:String x:Key="LblProcessing">🧠 TRAITEMENT...&#x0a;(Veuillez patienter)</sys:String>
    <sys:String x:Key="BtnSelectMicText">📋 Sélectionner le micro (Liste)</sys:String>
    <sys:String x:Key="BtnPromptText">🏷️ Éditeur de dictionnaire (Prompt)</sys:String>
    <sys:String x:Key="BtnSettingsText">⚙️ Paramètres</sys:String>
    <sys:String x:Key="BtnSettingsTooltip">Paramètres de langue, modèle, VAD et raccourcis</sys:String>
    <sys:String x:Key="BtnOpenNotepadText">📝 Ouvrir le bloc-notes</sys:String>
    <sys:String x:Key="LblSignalLevel">Niveau du signal :</sys:String>
    <sys:String x:Key="LblMicVolume">Volume du microphone :</sys:String>
    <sys:String x:Key="LblSelectedDevice">Périphérique : </sys:String>
    <sys:String x:Key="VadStatusText">VAD : attente de pause...</sys:String>
    <sys:String x:Key="BtnCancelText">⛔ Annuler le traitement</sys:String>
    <sys:String x:Key="LblCancelled">⛔ Annulé</sys:String>
    <sys:String x:Key="LblHistoryHeader">📋 Historique (cliquer pour copier) :</sys:String>
    <sys:String x:Key="BtnClearHistoryTooltip">Effacer l'historique</sys:String>
    <sys:String x:Key="CopyFeedbackText">✓ Copié dans le presse-papiers</sys:String>

    <!-- ══ Tray ══════════════════════════════════════════════════ -->
    <sys:String x:Key="TrayMenuControl">⚙️ Panneau de contrôle (F7)</sys:String>
    <sys:String x:Key="TrayMenuNotepad">📝 Bloc-notes (Ctrl+F7)</sys:String>
    <sys:String x:Key="TrayMenuExit">❌ Quitter</sys:String>
    <sys:String x:Key="TrayIconText">Whisper Voice</sys:String>

    <!-- ══ MessageBox ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MsgLowResourcesTitle">⚠️ Ressources insuffisantes</sys:String>
    <sys:String x:Key="MsgVramTitle">⚠️ VRAM</sys:String>
    <sys:String x:Key="MsgVramContinue">&#x0a;&#x0a;Continuer quand même ?</sys:String>
    <sys:String x:Key="MsgWhisperErrorTitle">Erreur Whisper</sys:String>
    <sys:String x:Key="MsgErrorTitle">Erreur</sys:String>
    <sys:String x:Key="MsgHallucinationFiltered">⚠️ Résultat filtré</sys:String>
    <sys:String x:Key="MsgWhisperDone">✅ Terminé !</sys:String>
    <sys:String x:Key="MsgWhisperStarting">🔍 Démarrage de Whisper...</sys:String>

    <!-- ══ SettingsWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="SettingsTitle">Paramètres</sys:String>
    <sys:String x:Key="SettingsSectionLanguage">🌐 Langue et modèle</sys:String>
    <sys:String x:Key="SettingsLblLanguage">Langue pour l'enregistrement principal (Primary) :</sys:String>
    <sys:String x:Key="SettingsLblLanguageTooltip">Sélectionnez la langue pour la touche principale</sys:String>
    <sys:String x:Key="SettingsLblModel">🤖 Modèle Whisper :</sys:String>
    <sys:String x:Key="SettingsModelComboTooltip">Sélectionnez le modèle depuis le dossier /models</sys:String>
    <sys:String x:Key="SettingsBtnRefreshTooltip">Actualiser la liste des modèles</sys:String>
    <sys:String x:Key="SettingsSectionVad">🎙️ VAD — Détection automatique du silence</sys:String>
    <sys:String x:Key="SettingsLblVadThreshold">Seuil de bruit (seuil → arrêt) :</sys:String>
    <sys:String x:Key="SettingsHintVadThreshold">Moins = plus sensible au silence  |  Plus = tolère le bruit</sys:String>
    <sys:String x:Key="SettingsLblVadSilence">Pause de silence (secondes avant arrêt) :</sys:String>
    <sys:String x:Key="SettingsHintVadSilence">Durée du silence avant l'arrêt automatique</sys:String>
    <sys:String x:Key="SettingsSectionHotkeys">⌨️ Raccourcis clavier</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrimary">Enregistrement — langue principale (Primary) :</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrimary">Touche pour démarrer/arrêter l'enregistrement</sys:String>
    <sys:String x:Key="SettingsLblHotkeyTranslate">Enregistrement — traduire en anglais (Translate) :</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyTranslate">Touche pour enregistrer avec traduction forcée en anglais</sys:String>
    <sys:String x:Key="SettingsSectionAppLanguage">🖥️ Langue de l'application</sys:String>
    <sys:String x:Key="SettingsLblAppLanguage">Langue de l'interface :</sys:String>
    <sys:String x:Key="SettingsLblAppLanguageTooltip">Change la langue de l'interface immédiatement</sys:String>
    <sys:String x:Key="BtnSaveCloseText">💾 Enregistrer et fermer</sys:String>
    <sys:String x:Key="BtnSaveCloseTooltip">Enregistrer toutes les modifications et fermer la fenêtre</sys:String>

</ResourceDictionary>