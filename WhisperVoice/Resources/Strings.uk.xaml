<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══ MainWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="AppTitle">Whisper Control Panel</sys:String>
    <sys:String x:Key="MainHeaderText">⚙️ Налаштування</sys:String>
    <sys:String x:Key="LblNoMicSelected">⚠️ ОБЕРІТЬ МІКРОФОН!</sys:String>
    <sys:String x:Key="LblRecording">🔴 ЗАПИС...</sys:String>
    <sys:String x:Key="LblProcessing">🧠 ОБРОБКА...&#x0a;(Зачекайте)</sys:String>
    <sys:String x:Key="BtnSelectMicText">📋 Вибрати мікрофон (Список)</sys:String>
    <sys:String x:Key="BtnPromptText">🏷️ Редактор словника (Prompt)</sys:String>
    <sys:String x:Key="BtnSettingsText">⚙️ Налаштування</sys:String>
    <sys:String x:Key="BtnSettingsTooltip">Налаштування мови, моделі, VAD та гарячих клавіш</sys:String>
    <sys:String x:Key="BtnOpenNotepadText">📝 Відкрити Блокнот</sys:String>
    <sys:String x:Key="LblSignalLevel">Рівень сигналу:</sys:String>
    <sys:String x:Key="LblMicVolume">Гучність мікрофона:</sys:String>
    <sys:String x:Key="LblSelectedDevice">Пристрій: </sys:String>
    <sys:String x:Key="VadStatusText">VAD: очікування паузи...</sys:String>
    <sys:String x:Key="BtnCancelText">⛔ Скасувати обробку</sys:String>
    <sys:String x:Key="LblCancelled">⛔ Скасовано</sys:String>
    <sys:String x:Key="LblHistoryHeader">📋 Історія (натисни — скопіювати):</sys:String>
    <sys:String x:Key="BtnClearHistoryTooltip">Очистити історію</sys:String>
    <sys:String x:Key="CopyFeedbackText">✓ Скопійовано</sys:String>

    <!-- ══ Tray ══════════════════════════════════════════════════ -->
    <sys:String x:Key="TrayMenuControl">⚙️ Панель керування (F7)</sys:String>
    <sys:String x:Key="TrayMenuNotepad">📝 Блокнот (Ctrl+F7)</sys:String>
    <sys:String x:Key="TrayMenuExit">❌ Вихід</sys:String>
    <sys:String x:Key="TrayIconText">Whisper Voice</sys:String>

    <!-- ══ MessageBox ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MsgLowResourcesTitle">⚠️ Недостатньо ресурсів</sys:String>
    <sys:String x:Key="MsgVramTitle">⚠️ VRAM</sys:String>
    <sys:String x:Key="MsgVramContinue">&#x0a;&#x0a;Продовжити все одно?</sys:String>
    <sys:String x:Key="MsgWhisperErrorTitle">Помилка Whisper</sys:String>
    <sys:String x:Key="MsgErrorTitle">Помилка</sys:String>
    <sys:String x:Key="MsgHallucinationFiltered">⚠️ Результат відфільтровано</sys:String>
    <sys:String x:Key="MsgWhisperDone">✅ Готово!</sys:String>
    <sys:String x:Key="MsgWhisperStarting">🔍 Запуск Whisper...</sys:String>

    <!-- ══ SettingsWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="SettingsTitle">Параметри</sys:String>
    <sys:String x:Key="SettingsSectionLanguage">🌐 Мова та модель</sys:String>
    <sys:String x:Key="SettingsLblLanguage">Мова для основного запису (Primary):</sys:String>
    <sys:String x:Key="SettingsLblLanguageTooltip">Оберіть мову для запису основною гарячою клавішею</sys:String>
    <sys:String x:Key="SettingsLblModel">🤖 Модель Whisper:</sys:String>
    <sys:String x:Key="SettingsModelComboTooltip">Оберіть модель із папки /models</sys:String>
    <sys:String x:Key="SettingsBtnRefreshTooltip">Оновити список моделей</sys:String>
    <sys:String x:Key="SettingsSectionVad">🎙️ VAD — Автодетекція тиші</sys:String>
    <sys:String x:Key="SettingsLblVadThreshold">Поріг шуму (поріг → стоп):</sys:String>
    <sys:String x:Key="SettingsHintVadThreshold">Менше = чутливіше до тиші  |  Більше = терпить шум</sys:String>
    <sys:String x:Key="SettingsLblVadSilence">Пауза тиші (секунд до зупинки):</sys:String>
    <sys:String x:Key="SettingsHintVadSilence">Тривалість тиші перед автоматичним зупиненням запису</sys:String>
    <sys:String x:Key="SettingsSectionHotkeys">⌨️ Гарячі клавіші</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrimary">Запис — основна мова (Primary):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrimary">Клавіша для запуску/зупинки запису на основній мові</sys:String>
    <sys:String x:Key="SettingsLblHotkeyTranslate">Запис — переклад на English (Translate):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyTranslate">Клавіша для запису з примусовим перекладом на англійську</sys:String>
    <sys:String x:Key="SettingsLblHotkeyPrompt">Запис — з тех. промптом (Prompt):</sys:String>
    <sys:String x:Key="SettingsTooltipHotkeyPrompt">Клавіша для запису з ін'єкцією технічного промпту</sys:String>
    <sys:String x:Key="SettingsSectionAppLanguage">🖥️ Мова інтерфейсу</sys:String>
    <sys:String x:Key="SettingsLblAppLanguage">Мова інтерфейсу програми:</sys:String>
    <sys:String x:Key="SettingsLblAppLanguageTooltip">Миттєво змінює мову інтерфейсу</sys:String>
    <sys:String x:Key="BtnSaveCloseText">💾 Зберегти і закрити</sys:String>
    <sys:String x:Key="BtnSaveCloseTooltip">Зберегти всі зміни та закрити вікно</sys:String>


    <!-- ══ Errors ══════════════════════════════════════════════════ -->
    <sys:String x:Key="ErrMicUnplugged">Мікрофон недоступний або відключений. Перевірте підключення.</sys:String>
    <!-- ══ WindowTitles ══════════════════════════════════════════════════ -->
    <sys:String x:Key="WindowTitleMicSelection">Оберіть мікрофон</sys:String>
    <sys:String x:Key="WindowTitleNotepad">Whisper: Блокнот</sys:String>
    <sys:String x:Key="WindowTitlePrompt">Словник (Tech Prompt)</sys:String>

    <!-- ══ MissingModelWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="MissingModelTitle">⚠️ Модель ШІ не знайдена</sys:String>
    <sys:String x:Key="MissingModelBody">Модель ШІ не знайдена. Завантажте модель і вкажіть шлях у Налаштуваннях.</sys:String>
    <sys:String x:Key="MissingModelDownloadBtn">⬇️ Завантажити модель (Hugging Face)</sys:String>
    <sys:String x:Key="MissingModelSettingsBtn">⚙️ Відкрити налаштування</sys:String>
    <sys:String x:Key="WindowTitleMissingModel">Модель ШІ не знайдена</sys:String>

    <!-- ══ HardwareCheckService ══════════════════════════════════════════ -->
    <sys:String x:Key="ErrLowRam">Недостатньо оперативної пам'яті (потрібно ≥ {0} МБ вільно).</sys:String>
    <sys:String x:Key="ErrLowVram">VRAM майже заповнена ({0} МБ вільно, потрібно ≥ {1} МБ).</sys:String>

    <!-- ══ SettingsWindow — MessageBoxes ════════════════════════════════ -->
    <sys:String x:Key="MsgModelExistsBody">Модель '{0}' вже існує.&#x0a;Перезаписати?</sys:String>
    <sys:String x:Key="MsgModelExistsTitle">Модель існує</sys:String>
    <sys:String x:Key="MsgModelAddedBody">Модель '{0}' успішно додана.</sys:String>
    <sys:String x:Key="MsgModelAddedTitle">Успіх</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedBody">Доступ заборонено. Запустіть від імені адміністратора або оберіть іншу папку.</sys:String>
    <sys:String x:Key="MsgModelAccessDeniedTitle">Помилка</sys:String>
    <sys:String x:Key="MsgModelFailedBody">Не вдалося додати модель:&#x0a;{0}</sys:String>
    <sys:String x:Key="MsgModelFailedTitle">Помилка</sys:String>
    <sys:String x:Key="MsgModelLoadErrorAccess">Доступ заборонено — перевірте права</sys:String>
    <sys:String x:Key="MsgModelLoadError">Помилка: {0}</sys:String>
    <sys:String x:Key="MsgResetSlidersBody">Скинути налаштування VAD і параметри Whisper до значень за замовчуванням?&#x0a;&#x0a;• Поріг шуму → 5 %&#x0a;• Пауза тиші → 1,8 с&#x0a;• Beam Size → 5&#x0a;• Best Of → 5&#x0a;• Temperature → 0,00&#x0a;• No-Speech Threshold → 0,60&#x0a;&#x0a;Мова, модель, гарячі клавіші та системні налаштування не зміняться.</sys:String>
    <sys:String x:Key="MsgResetSlidersTitle">Скидання налаштувань</sys:String>
    <sys:String x:Key="MsgInfoTitle">Інформація</sys:String>
    <sys:String x:Key="MsgUnhandledErrorBody">Помилка:&#x0a;{0}</sys:String>

    <!-- ══ SettingsWindow — VAD unit suffix ════════════════════════════ -->
    <sys:String x:Key="UnitSeconds"> с</sys:String>

    <!-- ══ Language display names (for UpdateLanguageButton) ═══════════ -->
    <sys:String x:Key="LangNameEn">Англійська</sys:String>
    <sys:String x:Key="LangNameRu">Російська</sys:String>
    <sys:String x:Key="LangNameUk">Українська</sys:String>
    <sys:String x:Key="LangNamePl">Польська</sys:String>
    <sys:String x:Key="LangNameDe">Німецька</sys:String>
    <sys:String x:Key="LangNameEs">Іспанська</sys:String>
    <sys:String x:Key="LangNameFr">Французька</sys:String>

    <!-- ══ MicWindow ══════════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnWinSoundText">⚙️ Налаштування звуку Windows</sys:String>
    <sys:String x:Key="BtnSelectText">Вибрати</sys:String>

    <!-- ══ PromptWindow ═══════════════════════════════════════════════════ -->
    <sys:String x:Key="PromptPrimaryLabel">Теги-підказки для нейромережі:</sys:String>
    <sys:String x:Key="PromptTranslateLabel">Промпт для перекладу (передається в --prompt):</sys:String>
    <sys:String x:Key="BtnAddTagText">➕ Додати</sys:String>
    <sys:String x:Key="BtnDeleteTagText">❌ Видалити</sys:String>
    <sys:String x:Key="BtnPromptSaveText">💾 Зберегти</sys:String>

    <!-- ══ NotepadWindow ══════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnCopyAllText">📋 Копіювати все</sys:String>
    <sys:String x:Key="BtnClearAllText">🗑️ Стерти все</sys:String>

    <!-- ══ SettingsWindow — Whisper Params section ════════════════════════ -->
    <sys:String x:Key="SettingsSectionWhisperParams">⚙️ Параметри Whisper</sys:String>
    <sys:String x:Key="SettingsHintBeamSize">Ширина пошуку (1 = жадібний, 5 = за замовчуванням)</sys:String>
    <sys:String x:Key="SettingsHintBestOf">Кандидати при beam-size=1 (5 = за замовчуванням)</sys:String>
    <sys:String x:Key="SettingsWarnBestOf">⚠ Впливає лише при Temperature &gt; 0</sys:String>
    <sys:String x:Key="SettingsHintTemperature">0.0 = детермінований, вище = творчий</sys:String>
    <sys:String x:Key="SettingsHintNoSpeech">Сегменти нижче цього порогу = тиша (0.6 = за замовчуванням)</sys:String>

    <!-- ══ SettingsWindow — System section ════════════════════════════════ -->
    <sys:String x:Key="SettingsSectionSystem">🖥️ Система</sys:String>
    <sys:String x:Key="ChkRunAtStartupText">Запускати з Windows</sys:String>
    <sys:String x:Key="ChkSoundNotificationsText">Звукові сповіщення (старт / стоп запису)</sys:String>

    <!-- ══ SettingsWindow — Push-to-Talk ════════════════════════════════ -->
    <sys:String x:Key="ChkPushToTalkText">Режим Push-to-Talk (утримання = запис, відпустити = стоп)</sys:String>
    <sys:String x:Key="ChkPushToTalkTooltip">Утримуйте клавішу для запису, відпустіть — для транскрипції. Замінює режим перемикання для клавіш Primary та Translate.</sys:String>
    <sys:String x:Key="ChkPushToTalkHint">Лише клавіші Primary та Translate. Меню і Блокнот залишаються в режимі перемикання.</sys:String>
    <sys:String x:Key="BtnResetSlidersText">↺ Скинути до значень за замовчуванням</sys:String>
    <sys:String x:Key="BtnResetSlidersTooltip">Скидає VAD (поріг шуму, пауза тиші) та параметри Whisper (Beam Size, Best Of, Temperature, No-Speech Threshold). Мова, модель, гарячі клавіші та системні налаштування не зачіпаються.</sys:String>

    <sys:String x:Key="ChkAutoClipboardText">Автокопіювання в буфер</sys:String>
    <sys:String x:Key="ChkAutoClipboardTooltip">Автоматично копіювати транскрипцію та вставляти через Ctrl+V</sys:String>
    <sys:String x:Key="ChkAutoClipboardHint">Вимкніть, щоб результат зберігався лише в історії (режим приватності)</sys:String>
    <sys:String x:Key="MsgVulkanCpuFallback">⚠️ Увага: інференс працює на CPU. Перевірте підтримку Vulkan.</sys:String>

    <sys:String x:Key="ModePushToTalk">Утримання (Push)</sys:String>
    <sys:String x:Key="ModeToggle">Перемикання</sys:String>
    <sys:String x:Key="ToolTipPrivacyPolicy">Запис тимчасово зберігається локально до завершення інференсу та видаляється при виході.</sys:String>

    <!-- ══ Hero Button ═══════════════════════════════════════════════════ -->
    <sys:String x:Key="BtnHeroIdle">Запис</sys:String>
    <sys:String x:Key="BtnHeroRecording">СТОП</sys:String>
    <sys:String x:Key="BtnHeroProcessing">Обробка...</sys:String>
    <!-- Settings Tabs -->
    <sys:String x:Key="SettingsTabGeneral">Основні</sys:String>
    <sys:String x:Key="SettingsTabAudio">Аудіо та ШІ</sys:String>
    <sys:String x:Key="SettingsTabHotkeys">Гарячі клавіші</sys:String>
</ResourceDictionary>
