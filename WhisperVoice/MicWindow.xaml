<Window x:Class="WhisperVoice.MicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitleMicSelection}" Height="340" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="LbMics" Grid.Row="0" Margin="0,0,0,8"
                 DisplayMemberPath="Name"
                 MouseDoubleClick="LbMics_MouseDoubleClick"/>

        <Button Grid.Row="1" Content="{DynamicResource BtnWinSoundText}"
                Height="30" HorizontalAlignment="Stretch"
                Margin="0,0,0,8"
                Click="BtnWinSound_Click"/>

        <Button Grid.Row="2" Content="{DynamicResource BtnSelectText}"
                Height="30" Width="100" HorizontalAlignment="Center"
                Click="BtnSelect_Click"/>
    </Grid>
</Window>
