<Window x:Class="WhisperVoice.Views.ModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get Models — WhisperVoice"
        Width="640" Height="540" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="ControlHost" Grid.Row="0"/>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="0,1,0,0"
                Padding="10,7" Background="#FAFAFA">
            <Button Content="Close" MinWidth="80" Padding="10,4"
                    HorizontalAlignment="Right" IsCancel="True"
                    Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
