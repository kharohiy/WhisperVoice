<Window x:Class="WhisperVoice.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры языка" Height="250" Width="350"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F0F0F0" WindowStyle="SingleBorderWindow">

    <StackPanel Margin="20" VerticalAlignment="Top">

        <TextBlock Text="Язык для F8 (Транскрипция)" FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,16" Foreground="#333"/>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Язык для F8 (Транскрипция):" FontSize="12" Foreground="#555"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="LanguageCombo" Height="32" FontSize="12" 
                      VerticalContentAlignment="Center"
                      ToolTip="Выберите язык для записи по F8"/>
        </StackPanel>

        <Button x:Name="BtnSaveClose" Content="💾 Сохранить и закрыть" Height="36"
                Click="BtnSaveClose_Click" 
                Background="#4CAF50" Foreground="White" FontSize="12" FontWeight="SemiBold"
                Cursor="Hand"
                ToolTip="Сохранить изменения и закрыть окно"/>

    </StackPanel>
</Window>