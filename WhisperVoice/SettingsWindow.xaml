<Window x:Class="WhisperVoice.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Height="650" Width="390"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F0F0F0" WindowStyle="SingleBorderWindow">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel Margin="20" VerticalAlignment="Top">

            <!-- ══ SECTION: App Interface Language ═══════════════════════ -->
            <TextBlock Text="{DynamicResource SettingsSectionAppLanguage}"
                 FontSize="14" FontWeight="SemiBold"
                 Margin="0,0,0,14" Foreground="#333"/>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource SettingsLblAppLanguage}"
                     FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                <ComboBox x:Name="AppLanguageCombo" Height="32" FontSize="12"
                    VerticalContentAlignment="Center"
                    SelectionChanged="AppLanguageCombo_SelectionChanged"
                    ToolTip="{DynamicResource SettingsLblAppLanguageTooltip}"/>
            </StackPanel>

            <!-- ══ SECTION: Language & Model ══════════════════════════════ -->
            <TextBlock Text="{DynamicResource SettingsSectionLanguage}"
                    FontSize="14" FontWeight="SemiBold"
                    Margin="0,0,0,14" Foreground="#333"/>

            <!-- Language for Primary hotkey -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource SettingsLblLanguage}"
                           FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                <ComboBox x:Name="LanguageCombo" Height="32" FontSize="12"
                          VerticalContentAlignment="Center"
                          ToolTip="{DynamicResource SettingsLblLanguageTooltip}"/>
            </StackPanel>

            <Separator Margin="0,10,0,10" Background="#CCCCCC"/>

            <!-- Model Whisper -->
            <TextBlock Text="{DynamicResource SettingsLblModel}" Margin="0,12,0,4" FontSize="12" FontWeight="SemiBold"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Model ComboBox -->
                <ComboBox x:Name="ModelCombo"
                          Grid.Column="0"
                          Margin="0,0,6,0"
                          SelectionChanged="ModelCombo_SelectionChanged"/>

                <!-- Add Button -->
                <Button x:Name="BtnAddModel"
                        Grid.Column="1"
                        Content="➕"
                        Width="32" Height="32"
                        Margin="0,0,4,0"
                        ToolTip="Add model from file"
                        Click="BtnAddModel_Click"/>

                <!-- Refresh Button -->
                <Button x:Name="BtnRefreshModels"
                        Grid.Column="2"
                        Content="🔄"
                        Width="32" Height="32"
                        Margin="0,0,4,0"
                        ToolTip="Refresh models list"
                        Click="BtnRefreshModels_Click"/>

                <!-- Get Models (opens Model Downloader window) -->
                <Button x:Name="BtnGetModels"
                        Grid.Column="3"
                        Content="⬇ Get Models…"
                        Height="32" Padding="8,0"
                        ToolTip="Download models automatically"
                        Click="BtnGetModels_Click"/>
            </Grid>

            <Separator Margin="0,16,0,14" Background="#CCCCCC"/>

            <!-- ══ SECTION: VAD ════════════════════════════════════════════ -->
            <TextBlock Text="{DynamicResource SettingsSectionVad}"
                       FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,14" Foreground="#333"/>

            <!-- VAD Threshold -->
            <StackPanel Margin="0,0,0,14">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource SettingsLblVadThreshold}"
                               FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtVadThreshold"
                               HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold" Foreground="#1565C0"
                               VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="SldVadThreshold"
                        Minimum="1.0" Maximum="20.0" TickFrequency="0.5"
                        IsSnapToTickEnabled="True" Height="28"
                        ValueChanged="SldVadThreshold_ValueChanged"/>
                <TextBlock Text="{DynamicResource SettingsHintVadThreshold}"
                           FontSize="10" Foreground="#888" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- VAD Silence Timeout -->
            <StackPanel Margin="0,0,0,4">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource SettingsLblVadSilence}"
                               FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtVadSilence"
                               HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold" Foreground="#1565C0"
                               VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="SldVadSilence"
                        Minimum="0.5" Maximum="5.0" TickFrequency="0.1"
                        IsSnapToTickEnabled="True" Height="28"
                        ValueChanged="SldVadSilence_ValueChanged"/>
                <TextBlock Text="{DynamicResource SettingsHintVadSilence}"
                           FontSize="10" Foreground="#888" Margin="0,3,0,0"/>
            </StackPanel>

            <Separator Margin="0,16,0,14" Background="#CCCCCC"/>

            <!-- ══ SECTION: Whisper Params ════════════════════════════════ -->
            <TextBlock Text="{DynamicResource SettingsSectionWhisperParams}"
                       FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,14" Foreground="#333"/>

            <!-- Beam Size -->
            <StackPanel Margin="0,0,0,14">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Beam Size" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBeamSize" HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="SldBeamSize" Minimum="1" Maximum="10" TickFrequency="1"
                        IsSnapToTickEnabled="True" Height="28"
                        ValueChanged="SldBeamSize_ValueChanged"/>
                <TextBlock Text="{DynamicResource SettingsHintBeamSize}"
                           FontSize="10" Foreground="#888" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Best Of -->
            <StackPanel Margin="0,0,0,14">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Best Of" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBestOf" HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="SldBestOf" Minimum="1" Maximum="10" TickFrequency="1"
                        IsSnapToTickEnabled="True" Height="28"
                        ValueChanged="SldBestOf_ValueChanged"/>
                <TextBlock Text="{DynamicResource SettingsHintBestOf}"
                           FontSize="10" Foreground="#888" Margin="0,3,0,0"/>
                <TextBlock Text="{DynamicResource SettingsWarnBestOf}"
                           FontSize="10" Foreground="#E65100" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Temperature -->
            <StackPanel Margin="0,0,0,14">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Temperature" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTemperature" HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="SldTemperature" Minimum="0.0" Maximum="1.0" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" Height="28"
                        ValueChanged="SldTemperature_ValueChanged"/>
                <TextBlock Text="{DynamicResource SettingsHintTemperature}"
                           FontSize="10" Foreground="#888" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- No-Speech Threshold -->
            <StackPanel Margin="0,0,0,4">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="No-Speech Threshold" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtNoSpeechThold" HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="SldNoSpeechThold" Minimum="0.0" Maximum="1.0" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" Height="28"
                        ValueChanged="SldNoSpeechThold_ValueChanged"/>
                <TextBlock Text="{DynamicResource SettingsHintNoSpeech}"
                           FontSize="10" Foreground="#888" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- ══ SECTION: Hotkeys ════════════════════════════════════════ -->
            <TextBlock Text="{DynamicResource SettingsSectionHotkeys}"
                       FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,14" Foreground="#333"/>

            <!-- HotkeyPrimary (was HotkeyRu) -->
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource SettingsLblHotkeyPrimary}"
                           FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                <ComboBox x:Name="ComboHotkeyPrimary" Height="32" FontSize="12"
                          VerticalContentAlignment="Center"
                          ToolTip="{DynamicResource SettingsTooltipHotkeyPrimary}"/>
            </StackPanel>

            <!-- HotkeyTranslate (was HotkeyEn) -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource SettingsLblHotkeyTranslate}"
                           FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                <ComboBox x:Name="ComboHotkeyTranslate" Height="32" FontSize="12"
                          VerticalContentAlignment="Center"
                          ToolTip="{DynamicResource SettingsTooltipHotkeyTranslate}"/>
            </StackPanel>
            
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource SettingsLblHotkeyPrompt}"
                           FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
                <ComboBox x:Name="ComboHotkeyPrompt" Height="32" FontSize="12"
                          VerticalContentAlignment="Center"
                          ToolTip="{DynamicResource SettingsTooltipHotkeyPrompt}"/>
            </StackPanel>

            <Separator Margin="0,16,0,14" Background="#CCCCCC"/>

            <!-- ══ SECTION: System ════════════════════════════════════════ -->
            <TextBlock Text="{DynamicResource SettingsSectionSystem}"
                       FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,14" Foreground="#333"/>

            <CheckBox x:Name="ChkRunAtStartup"
                      Content="{DynamicResource ChkRunAtStartupText}"
                      FontSize="12" Margin="0,0,0,12"
                      Checked="ChkRunAtStartup_Changed"
                      Unchecked="ChkRunAtStartup_Changed"/>

            <CheckBox x:Name="ChkSoundNotifications"
                      Content="{DynamicResource ChkSoundNotificationsText}"
                      FontSize="12" Margin="0,0,0,12"/>

            <CheckBox x:Name="ChkAutoClipboard"
                      Content="{DynamicResource ChkAutoClipboardText}"
                      FontSize="12" Margin="0,0,0,4"
                      ToolTip="{DynamicResource ChkAutoClipboardTooltip}"/>
            <TextBlock Text="{DynamicResource ChkAutoClipboardHint}"
                      TextWrapping="Wrap"
                      FontSize="10" Foreground="#888" Margin="18,0,0,12"/>

            <!-- Push-to-Talk mode -->
            <CheckBox x:Name="ChkPushToTalk"
                      Content="{DynamicResource ChkPushToTalkText}"
                      FontSize="12" Margin="0,0,0,4"
                      ToolTip="{DynamicResource ChkPushToTalkTooltip}"/>
            <TextBlock Text="{DynamicResource ChkPushToTalkHint}"
                      TextWrapping="Wrap"
                      FontSize="10" Foreground="#888" Margin="18,0,0,20"/>

            <!-- Reset sliders button -->
            <Button x:Name="BtnResetSliders"
                    Content="{DynamicResource BtnResetSlidersText}"
                    Height="34" Margin="0,0,0,8"
                    Click="BtnResetSliders_Click"
                    Background="#E0E0E0" Foreground="#333"
                    FontSize="12" Cursor="Hand"
                    ToolTip="{DynamicResource BtnResetSlidersTooltip}"/>

            <!-- Save button -->
            <Button x:Name="BtnSaveClose"
                    Content="{DynamicResource BtnSaveCloseText}"
                    Height="38"
                    Click="BtnSaveClose_Click"
                    Background="#4CAF50" Foreground="White"
                    FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                    ToolTip="{DynamicResource BtnSaveCloseTooltip}"/>

        </StackPanel>
    </ScrollViewer>
</Window>
