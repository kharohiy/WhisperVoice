<Window x:Class="WhisperVoice.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitlePrompt}" Height="470" Width="380"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize"
        Closing="Window_Closing" Background="#F9F9F9">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,10">

            <!-- ── Tab 1: Primary hotkey prompt (tag list) ── -->
            <TabItem Header="Primary (F8)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Теги-подсказки для нейросети:" FontSize="13"
                               FontWeight="Medium" Margin="0,0,0,8"/>

                    <ListBox x:Name="LbTags" Grid.Row="1"
                             ItemsSource="{Binding Tags}"
                             Margin="0,0,0,10" FontSize="13"
                             SelectionChanged="LbTags_SelectionChanged"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInput" Grid.Column="0" FontSize="13"
                                 VerticalContentAlignment="Center" Padding="5,0"/>
                        <Button Grid.Column="2" Content="➕ Добавить" Width="80" Height="28" Click="BtnAdd_Click"/>
                        <Button Grid.Column="4" Content="❌ Удалить" Width="75" Height="28" Click="BtnDelete_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Tab 2: Translate hotkey prompt (free text) ── -->
            <TabItem Header="Translate (F9)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Промпт для перевода (передаётся в --prompt):"
                               FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtTranslatePrompt" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             FontSize="13" Padding="5"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

        </TabControl>

        <Button Grid.Row="1" Content="💾 Сохранить" Height="38"
                FontSize="14" FontWeight="Bold" Click="BtnSave_Click"/>
    </Grid>
</Window>